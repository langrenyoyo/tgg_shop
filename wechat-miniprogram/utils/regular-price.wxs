function display(value) {
  if (typeof value === 'string') return value;
  return typeof value === 'number' && value > 0 ? '¥' + value : '';
}
function points(product) {
  if (!product) return '';
  return product.pointsPriceText || (product.pointsPrice || 0) + ' 积分';
}
function member(product) {
  if (!product) return '';
  return product.cashPriceText || '¥' + (product.cashPrice || 0);
}
module.exports = { display: display, points: points, member: member };
