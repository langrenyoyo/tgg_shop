page {
  background: #f5f8f5;
  color: #203b30;
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
}
.page { min-height: 100vh; box-sizing: border-box; padding: 24rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.card { background: #fff; border-radius: 28rpx; padding: 24rpx; box-shadow: 0 6rpx 24rpx rgba(32,59,48,.035); margin-bottom: 20rpx; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.title { font-size: 34rpx; font-weight: 700; }
.muted { color: #7b8b81; font-size: 24rpx; }
.btn { border: 0; border-radius: 999rpx; padding: 20rpx 28rpx; line-height: 1.4; font-size: 28rpx; font-weight: 600; }
.btn-primary { background: #00a865; color: #fff; }
.btn-light { background: #edf5ef; color: #32654b; }
.input, .textarea { width: 100%; box-sizing: border-box; border: 1rpx solid #e2eae2; border-radius: 18rpx; padding: 20rpx; background: #fff; }
.textarea { min-height: 180rpx; }
.grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.list-item { padding: 24rpx 0; border-bottom: 1rpx solid #eef3ed; }
.tag { display: inline-block; padding: 6rpx 12rpx; border-radius: 999rpx; background: #e8f7ee; color: #00965b; font-size: 22rpx; }
button::after { border: none; }
button[disabled] { opacity: .5; }
.search-box { display: flex; align-items: center; gap: 18rpx; padding: 0 26rpx; height: 88rpx; border-radius: 999rpx; background: #fff; border: 2rpx solid #e4eee6; }
.search-box input { flex: 1; min-width: 0; font-size: 26rpx; height: 84rpx; }
.search-icon { width: 24rpx; height: 24rpx; border: 3rpx solid #89a18e; border-radius: 50%; position: relative; flex-shrink: 0; margin-right: 6rpx; }
.search-icon::after { content: ''; position: absolute; width: 12rpx; height: 3rpx; background: #89a18e; transform: rotate(45deg); right: -9rpx; bottom: -4rpx; }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 32rpx 0 20rpx; }
.section-heading .title { font-size: 34rpx; }
.section-link { color: #008d56; background: #e4f4e9; padding: 10rpx 20rpx; border-radius: 999rpx; font-size: 23rpx; }
.product-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20rpx; }
.product-tile { min-width: 0; background: #fff; border-radius: 26rpx; overflow: hidden; padding: 10rpx; box-shadow: 0 8rpx 26rpx rgba(32,59,48,.035); }
.product-photo { width: 100%; height: 278rpx; border-radius: 20rpx; display: block; background: #f2f6f0; }
.photo-empty { display: flex; align-items: center; justify-content: center; color: #91a28e; font-size: 23rpx; }
.product-info { padding: 16rpx 10rpx 12rpx; }
.product-name { font-weight: 600; font-size: 28rpx; line-height: 1.5; height: 84rpx; overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.product-meta { color: #859184; font-size: 22rpx; margin: 8rpx 0 16rpx; min-height: 33rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.product-bottom { display: flex; justify-content: space-between; align-items: flex-end; gap: 6rpx; }
.product-price { color: #e6783d; font-size: 34rpx; font-weight: 700; overflow-wrap: break-word; min-width: 0; }
.product-price.points-price { color: #009b60; }
.price-label { display: block; font-size: 20rpx; font-weight: 400; color: #8b988a; margin-bottom: 2rpx; }
.product-arrow { width: 48rpx; height: 48rpx; border-radius: 50%; background: #e8f5eb; color: #009b60; text-align: center; line-height: 44rpx; font-size: 36rpx; flex-shrink: 0; }
.empty-state { padding: 60rpx 28rpx; text-align: center; color: #819184; font-size: 26rpx; line-height: 1.8; }
.empty-state button { margin: 24rpx auto 0; display: inline-block; }
