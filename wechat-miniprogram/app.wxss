page {
  background: #f5f7fb;
  color: #111827;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 23, 42, 0.06);
  margin-bottom: 20rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
}

.muted {
  color: #6b7280;
  font-size: 24rpx;
}

.btn {
  border: 0;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  line-height: 1;
}

.btn-primary {
  background: #16a34a;
  color: #fff;
}

.btn-light {
  background: #e5e7eb;
  color: #111827;
}

.input,
.textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 20rpx;
  background: #fff;
}

.textarea {
  min-height: 180rpx;
}

.grid-2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.list-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.tag {
  display: inline-block;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #e8f7ee;
  color: #16a34a;
  font-size: 22rpx;
}
