<view wx:if="{{unitId}}" class="slot {{flushTop ? 'slot-flush-top' : ''}} {{failed ? 'slot-empty' : ''}}">
  <ad-custom wx:if="{{kind === 'feed'}}" unit-id="{{unitId}}" bindload="loaded" binderror="failed"/>
  <ad wx:else unit-id="{{unitId}}" ad-type="banner" ad-intervals="60" bindload="loaded" binderror="failed"/>
</view>
<view wx:if="{{debug && diagnostic}}" class="ad-diagnostic">{{kind === 'feed' ? '信息流' : '横幅'}}广告：{{diagnostic}}</view>
