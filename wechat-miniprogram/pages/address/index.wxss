.page { padding-bottom: 40rpx; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.title { font-size: 30rpx; font-weight: 700; }
input, textarea { width: 100%; box-sizing: border-box; margin-top: 14rpx; border: 1rpx solid #dce8d9; border-radius: 14rpx; background: #fff; font-size: 28rpx; }
input { height: 76rpx; line-height: 76rpx; padding: 0 20rpx; }
textarea { min-height: 280rpx; line-height: 1.6; padding: 18rpx 20rpx; }
button { margin: 10rpx 8rpx 0 0; }
