<view class="page"><view class="card row"><view class="title">收货地址</view><button class="btn btn-light" bindtap="add">新增地址</button></view><view wx:if="{{error}}" class="card">{{error}}<button bindtap="load">重试</button></view><view wx:for="{{rows}}" wx:key="id" class="card"><view class="title">{{item.receiverName}} {{item.mobile}}</view><view>{{item.province}} {{item.city}} {{item.district}} {{item.detail}}</view><view wx:if="{{item.isDefault}}" class="tag">默认地址</view><button bindtap="edit" data-id="{{item.id}}">编辑</button><button bindtap="makeDefault" data-id="{{item.id}}">设为默认</button><button bindtap="remove" data-id="{{item.id}}">删除</button></view><view wx:if="{{editing}}" class="card"><view class="title">{{editing.id ? '编辑地址' : '新增地址'}}</view><input data-field="receiverName" value="{{editing.receiverName}}" bindinput="input" placeholder="收货人"/><input data-field="mobile" value="{{editing.mobile}}" bindinput="input" placeholder="手机号"/><input data-field="province" value="{{editing.province}}" bindinput="input" placeholder="省份"/><input data-field="city" value="{{editing.city}}" bindinput="input" placeholder="城市"/><input data-field="district" value="{{editing.district}}" bindinput="input" placeholder="区域"/><textarea data-field="detail" value="{{editing.detail}}" bindinput="input" placeholder="详细地址"/><button class="btn btn-primary" bindtap="save" disabled="{{saving}}">保存</button></view></view>
