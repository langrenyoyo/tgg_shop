<view class="page">
  <view class="card">
    <view class="title">邀请有礼</view>
    <view class="muted" style="margin-top:8rpx;">邀请奖励、提成和绑定关系</view>
  </view>

  <view class="card" wx:if="{{info}}">
    <view class="muted">我的邀请码</view>
    <view class="title" style="margin-top:10rpx;">{{info.inviteCode}}</view>
    <view class="muted" style="margin-top:10rpx;">邀请奖励 {{info.rewardInvite}} 积分</view>
    <view class="muted">邀请提成 {{info.rewardRatio}}%</view>
    <view class="invite-actions">
      <button class="btn btn-primary" bindtap="copyCode">复制邀请码</button>
      <button class="btn btn-primary" open-type="share" disabled="{{!info.inviteCode}}">邀请好友</button>
    </view>
    <view class="muted">累计邀请 {{info.totalInvited || 0}} 人 · 累计提成 {{info.totalCommission || 0}} 积分</view>
    <view class="invite-code">
      <view class="title">我的邀请小程序码</view>
      <view class="muted">好友用微信扫码进入小程序，首次注册后绑定邀请关系。</view>
      <image wx:if="{{codePath}}" class="invite-code-image" src="{{codePath}}" mode="aspectFit" bindtap="previewCode" show-menu-by-longpress="{{true}}" />
      <button wx:if="{{!codePath}}" class="btn btn-primary" bindtap="generateCode" loading="{{generating}}" disabled="{{generating}}">{{generating ? '正在生成' : '生成专属小程序码'}}</button>
      <button wx:if="{{codePath}}" class="btn btn-primary" bindtap="saveCode" loading="{{saving}}" disabled="{{saving}}">保存小程序码到相册</button>
      <view wx:if="{{codeError}}" class="invite-code-error">{{codeError}}</view>
      <button wx:if="{{albumDenied}}" open-type="openSetting">打开相册权限设置</button>
      <view wx:if="{{codePath}}" class="muted">保存后可发送给好友，或打印展示。已有账号不会重复绑定或发放注册奖励。</view>
    </view>
  </view>

  <view class="card">
    <view class="row">
      <view class="title">邀请列表</view>
      <button class="btn btn-primary" bindtap="load" loading="{{loading}}" disabled="{{loading}}">刷新</button>
    </view>
    <view wx:if="{{error}}">{{error}}<button bindtap="load">重试</button></view>
    <button wx:if="{{error === '请登录后查看邀请记录'}}" bindtap="goLogin">去登录</button>
    <view wx:if="{{!loading && !error && !list.length}}">暂无邀请记录，邀请好友后可在这里查看。</view>
    <view wx:for="{{list}}" wx:key="uid" class="list-item">
      <view class="row">
        <view>
          <view>{{item.nickname}}</view>
          <view class="muted">{{item.registeredAt}}</view>
        </view>
        <view class="tag">+{{item.contributed || 0}}</view>
      </view>
    </view>
  </view>
  <button wx:if="{{hasMore}}" bindtap="more" loading="{{loading}}" disabled="{{loading}}">加载更多</button>
</view>
