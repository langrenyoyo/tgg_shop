<view class="page">
<view wx:if="{{loading}}">正在加载商品</view>
<view wx:if="{{error}}" class="card">{{error}}<button bindtap="load">重试</button></view>
<view wx:if="{{product}}" class="card">
<image wx:if="{{product.image}}" src="{{product.image}}" mode="widthFix" style="width:100%"/>
<view class="title">{{product.name}}</view><view>{{product.tag}}</view>
<view wx:if="{{product.supportsPoints}}">{{product.pointsPrice}} 积分</view>
<view wx:if="{{product.supportsCash && !product.purePointsOnly}}" class="price-detail">
  <view wx:if="{{product.regularPrice > 0}}" class="regular-price">零售价 ¥{{product.regularPrice}}</view>
  <view class="member-highlight">会员价 ¥{{product.cashPrice}}</view>
</view>
<view class="muted">库存 {{product.stock}} · {{product.category}}</view>
<view wx:if="{{product.unit}}">规格：{{product.unit}}</view>
<view wx:if="{{product.description}}" style="white-space:pre-wrap">{{product.description}}</view>
<view wx:if="{{product.purePointsOnly}}" class="muted">纯积分兑换需先开通会员，不支持现金补差。</view>
<view wx:if="{{!isMember}}" class="muted">下单需先购买月会员，现金购买按会员价结算。</view>
<view class="detail-cart-controls"><text>购物车数量</text><view class="product-stepper"><button wx:if="{{cartQuantities[product.id] > 0}}" class="step-minus" catchtap="changeCart" data-delta="-1" aria-label="减少一件">−</button><text class="step-count">{{cartQuantities[product.id] || 0}}</text><button class="step-plus" catchtap="changeCart" data-delta="1" disabled="{{loading || navigating || product.stock <= 0 || product.status !== 'on' || cartQuantities[product.id] >= product.stock}}" aria-label="加入购物车">+</button></view></view>
<button bindtap="buy" disabled="{{loading || navigating || product.stock <= 0 || product.status !== 'on'}}" class="btn btn-primary">{{product.purePointsOnly ? '立即兑换' : '立即购买'}}</button>
<button bindtap="cart">查看购物车</button>
</view></view>
