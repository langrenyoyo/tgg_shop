.submission-proof { margin-top: 28rpx; padding-top: 24rpx; border-top: 1rpx solid #e8eee9; }
.proof-heading { margin: 12rpx 0 18rpx; font-size: 30rpx; font-weight: 600; }
.proof-field { display: flex; gap: 24rpx; padding: 10rpx 0; font-size: 26rpx; }
.proof-field > text:first-child { flex: 0 0 120rpx; color: #7b8b81; }
.proof-field > text:last-child { flex: 1; min-width: 0; overflow-wrap: break-word; white-space: pre-wrap; }
.proof-tip { color: #7b8b81; font-size: 24rpx; margin-bottom: 18rpx; }
.proof-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 24rpx; }
.proof-item { width: calc((100% - 16rpx) / 2); height: 300rpx; border-radius: 14rpx; overflow: hidden; background: #f2f6f2; }
.proof-image { display: block; width: 100%; height: 100%; }
.proof-failed { height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; color: #8b3f38; font-size: 24rpx; }
.proof-failed text { margin-top: 10rpx; color: #7b8b81; font-size: 22rpx; }
