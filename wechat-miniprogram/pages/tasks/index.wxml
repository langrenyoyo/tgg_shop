<view class="earn-page">
  <view class="subtabs">
    <button class="tab {{activeTab === 'tasks' ? 'active' : ''}}" bindtap="showTasks">做任务</button>
    <button class="tab" bindtap="openSignin">签到</button>
    <button class="tab {{activeTab === 'submissions' ? 'active' : ''}}" bindtap="showSubmissions">提交记录</button>
  </view>
  <block wx:if="{{activeTab === 'tasks'}}">
    <input class="search" placeholder="搜索任务 / 平台 / 关键词" value="{{search}}" bindinput="setSearch" bindconfirm="reload" confirm-type="search" />
    <view class="choice-row">
      <button wx:for="{{categories}}" wx:key="id" class="choice {{currentCid === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="setCategory">{{item.name}}</button>
    </view>
    <view class="task-card invite-card" bindtap="openInvite">
      <view class="icon-column"><view class="dot">邀</view></view>
      <view class="task-main"><view class="task-title">拉新任务 · 邀请好友</view><view class="description">奖励规则进入邀请页后查看。</view></view>
      <view class="state">去完成</view>
    </view>
    <view class="task-list">
      <view wx:for="{{tasks}}" wx:key="id" class="task-card" bindtap="openTask" data-id="{{item.id}}">
        <view class="icon-column"><view class="dot">任</view></view>
        <view class="task-main"><view class="task-title">{{item.title}}</view><view class="description">{{item.category ? item.category + ' · ' : ''}}奖励进入详情页查看</view></view>
        <view class="state {{item.paused ? 'warn' : ''}}">{{item.paused ? '暂停' : '去完成'}}</view>
      </view>
    </view>
  </block>
  <block wx:else>
    <view class="subtabs"><button wx:for="{{recordFilters}}" wx:key="id" class="tab {{recordStatus === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="filterRecords">{{item.name}}</button></view>
    <view class="record-card" wx:for="{{visibleSubmissions}}" wx:key="id" data-id="{{item.id}}" bindtap="openRecord">
      <view class="task-title">{{item.taskTitle || item.taskId}}</view>
      <view class="description">{{item.statusText}} · {{item.dateText}}</view>
      <view class="description" wx:if="{{item.remarks || item.reasons}}">{{item.remarks || item.reasons}}</view>
    </view>
  </block>
  <view class="empty" wx:if="{{loading}}">加载中…</view>
  <view class="empty" wx:elif="{{error}}"><view>{{error}}</view><button class="tab retry" bindtap="reload">重新加载</button></view>
  <view class="empty" wx:elif="{{activeTab === 'tasks' ? !tasks.length : !visibleSubmissions.length}}">{{activeTab === 'tasks' ? '暂无任务' : '暂无任务提交记录'}}</view>
  <button wx:if="{{hasMore && !loading && !error}}" bindtap="loadMore">加载更多</button>
</view>
