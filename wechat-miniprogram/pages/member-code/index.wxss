.member-code-page { padding: 40rpx 24rpx; }
.code-card { background: #fff; border-radius: 28rpx; padding: 40rpx 16rpx; text-align: center; box-shadow: 0 10rpx 40rpx rgba(32,59,48,.05); }
.code-brand { color: #009e60; font-size: 22rpx; letter-spacing: 5rpx; margin-bottom: 16rpx; }
.code-caption { margin-top: 12rpx; }
.code-content { margin-top: 36rpx; }
.barcode { width: 100%; height: 240rpx; background: #fff; }
.card-number { display: block; color: #111; font-size: 32rpx; font-family: monospace; overflow-wrap: anywhere; margin: 16rpx 0 24rpx; }
.code-state { padding: 44rpx 24rpx; color: #63786b; font-size: 28rpx; }
.code-state button { margin-top: 24rpx; }
.code-tips { padding: 32rpx 16rpx; color: #7b8b81; font-size: 24rpx; line-height: 1.8; }
.code-tips view { margin-bottom: 12rpx; }
