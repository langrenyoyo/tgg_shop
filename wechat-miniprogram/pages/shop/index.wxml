<view class="page category-page">
  <view class="shop-heading"><view class="title">发现新鲜好物</view><view class="muted">挑选所爱，把日常过得更好</view></view>
  <view class="search-box"><view class="search-icon"></view><input value="{{search}}" bindinput="search" placeholder="搜索你喜欢的商品" placeholder-style="color:#91a08f"/></view>
  <scroll-view scroll-x class="categories" enhanced show-scrollbar="{{false}}"><view class="category-options"><view wx:for="{{categories}}" wx:key="*this" data-category="{{item}}" bindtap="category" class="category-chip {{category === item ? 'active' : ''}}">{{item}}</view></view></scroll-view>
  <view class="shop-section"><view>{{category === '全部' ? '全部好物' : category}}</view><text>{{products.length}} 件商品</text></view>
  <view wx:if="{{category === '纯积分兑换'}}" class="exchange-note">纯积分兑换无需会员，使用积分即可下单</view>
  <view wx:if="{{error}}" class="empty-state card">{{error}}<view><button class="btn btn-light" bindtap="load">重新加载</button></view></view>
  <view wx:elif="{{loading}}" class="empty-state">好物加载中…</view>
  <view wx:elif="{{!products.length}}" class="empty-state card">暂无符合条件的商品<view class="muted">试试其他分类或关键词</view></view>
  <view class="product-grid"><view class="product-tile" wx:for="{{products}}" wx:key="id" bindtap="open" data-id="{{item.id}}">
    <image wx:if="{{item.image}}" class="product-photo" src="{{item.image}}" mode="aspectFill"/><view wx:else class="product-photo photo-empty">商品图片待更新</view>
    <view class="product-info"><view class="product-name">{{item.name}}</view><view class="product-meta">{{item.tag || item.category}}</view><view class="product-bottom"><view class="product-price {{item.purePointsOnly ? 'points-price' : ''}}"><text class="price-label">{{item.purePointsOnly ? '纯积分兑换' : '会员价'}}</text>{{item.purePointsOnly ? item.pointsPrice + ' 积分' : '¥' + item.cashPrice}}</view><view class="product-arrow">›</view></view></view>
  </view></view>
</view>
