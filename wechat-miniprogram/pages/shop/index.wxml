<wxs src="../../utils/regular-price.wxs" module="retail"/>
<view class="page category-page">
  <tgg-ad-slot id="shopTopBanner" class="shop-top-ad" flush-top="{{true}}"/>
  <view class="search-box"><view class="search-icon"></view><input value="{{search}}" bindinput="inputSearch" bindconfirm="search" confirm-type="search" placeholder="搜索你喜欢的商品" placeholder-style="color:#91a08f"/></view>
  <view class="shop-layout {{categoryCollapsed ? 'category-collapsed' : ''}}">
    <view class="category-sidebar-head"><text wx:if="{{!categoryCollapsed}}" class="category-sidebar-title">分类</text><button class="category-toggle" bindtap="toggleCategoryMenu" hover-class="category-toggle-pressed" aria-label="{{categoryCollapsed ? '展开分类菜单' : '收起分类菜单'}}"><text class="category-toggle-icon">{{categoryCollapsed ? '›' : '‹'}}</text></button></view>
    <view class="shop-section"><view>{{category === '' ? '全部好物' : category}}</view><text>{{total}} 件商品</text></view>
    <view class="category-sidebar">
      <scroll-view scroll-y class="category-scroll" enhanced show-scrollbar="{{false}}">
        <view wx:for="{{categories}}" wx:key="*this" data-category="{{item}}" bindtap="category" class="category-side-item {{category === item ? 'active' : ''}}"><text class="category-side-icon">{{item[0]}}</text><text class="category-side-name">{{item}}</text></view>
      </scroll-view>
    </view>
    <view class="shop-content">
      <scroll-view class="product-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-top="{{scrollTop}}" lower-threshold="160" bindscroll="onProductScroll" bindscrolltolower="loadMore">
      <tgg-ad-slot id="categoryBanner" flush-top="{{true}}"/>
      <view wx:if="{{category === '纯积分兑换'}}" class="exchange-note">纯积分兑换无需会员，使用积分下单</view>
      <view wx:if="{{category === '买商品送会员'}}" class="exchange-note">购买实物商品赠会员，非会员也可购买；支付成功后发放，已有会员顺延。</view>
      <view wx:if="{{error}}" class="empty-state card">{{error}}<view><button class="btn btn-light" bindtap="load">重新加载</button></view></view>
      <view wx:elif="{{loading}}" class="empty-state">好物加载中…</view>
      <view wx:elif="{{!products.length}}" class="empty-state card">暂无符合条件的商品<view class="muted">试试其他分类或关键词</view></view>
      <view class="product-grid"><view class="product-tile" wx:for="{{products}}" wx:key="id" bindtap="open" data-id="{{item.id}}">
        <image wx:if="{{item.image}}" class="product-photo" src="{{item.image}}" mode="aspectFit"/><view wx:else class="product-photo photo-empty">商品图片待更新</view>
        <view class="product-info"><view class="product-name">{{item.name}}</view><view class="product-meta">{{item.tag || item.category}}</view>
          <view wx:if="{{item.membershipGiftDays > 0}}" class="product-meta gift-note">每件赠 {{item.membershipGiftDays}} 天会员 · 非会员可购</view>
          <view wx:if="{{!item.purePointsOnly && retail.display(item.regularPrice)}}" class="regular-price">零售价 <text>{{retail.display(item.regularPrice)}}</text></view>
          <view class="product-bottom"><view class="product-price {{item.purePointsOnly ? 'points-price' : 'member-highlight'}}"><text class="price-label">{{item.purePointsOnly ? '纯积分兑换' : item.membershipGiftDays > 0 ? '活动价' : '会员价'}}</text>{{item.purePointsOnly ? retail.points(item) : retail.member(item)}}</view><button wx:if="{{item.category === '买商品送会员'}}" class="gift-buy-button" catchtap="buyGift" data-id="{{item.id}}" disabled="{{loading || navigating || item.status !== 'on' || item.stock <= 0 || !item.supportsCash || item.purePointsOnly || !(item.membershipGiftDays > 0)}}">现金购买</button><view wx:else class="product-stepper"><button wx:if="{{cartQuantities[item.id] > 0}}" class="step-minus" catchtap="changeCart" data-id="{{item.id}}" data-delta="-1" aria-label="减少一件">−</button><text wx:if="{{cartQuantities[item.id] > 0}}" class="step-count">{{cartQuantities[item.id]}}</text><button class="step-plus" catchtap="changeCart" data-id="{{item.id}}" data-delta="1" disabled="{{item.status !== 'on' || item.stock <= 0 || cartQuantities[item.id] >= item.stock}}" aria-label="加入购物车">+</button></view></view>
        </view>
      </view></view>
      <view wx:if="{{loadingMore}}" class="pagination-status">加载中…</view>
      <view wx:elif="{{moreError}}" class="pagination-status"><text>{{moreError}}</text><button class="btn btn-light" bindtap="loadMore">重试</button></view>
      <view wx:elif="{{products.length && !hasMore}}" class="pagination-status">已加载全部商品</view>
      </scroll-view>
    </view>
  </view>
</view>
