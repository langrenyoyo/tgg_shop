.shop-heading { margin: 8rpx 4rpx 28rpx; }.shop-heading .title { font-size: 40rpx; }.shop-heading .muted { margin-top: 8rpx; }
.shop-layout { display: flex; align-items: flex-start; gap: 18rpx; margin-top: 24rpx; }
.category-sidebar { width: 168rpx; flex: 0 0 168rpx; position: sticky; top: 12rpx; align-self: flex-start; }
.category-sidebar-head { display: flex; align-items: center; justify-content: flex-end; min-height: 80rpx; margin-bottom: 10rpx; }
.category-sidebar-title { flex: 1; padding-left: 10rpx; color: #718373; font-size: 24rpx; font-weight: 600; }
.category-toggle { flex: 0 0 78rpx; width: 78rpx; height: 80rpx; margin: 0; padding: 0; background: transparent; display: flex; align-items: center; justify-content: center; line-height: 1; }
.category-toggle-pressed { transform: scale(.97); opacity: .85; }
.category-toggle-icon { color: #32815a; font-size: 46rpx; line-height: 1; font-weight: 400; }
.category-scroll { max-height: 880rpx; padding: 4rpx 0; box-sizing: border-box; }
.category-side-item { min-height: 76rpx; margin-bottom: 10rpx; padding: 10rpx 8rpx; box-sizing: border-box; border-radius: 18rpx; display: flex; align-items: center; gap: 8rpx; background: #fff; color: #718373; font-size: 22rpx; }
.category-side-item.active { background: #009e60; color: #fff; font-weight: 600; box-shadow: 0 6rpx 16rpx rgba(0, 158, 96, .18); }
.category-side-icon { width: 38rpx; height: 38rpx; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: #edf6ed; color: #258b5a; font-size: 21rpx; flex: 0 0 38rpx; }
.category-side-item.active .category-side-icon { background: rgba(255,255,255,.2); color: #fff; }
.category-side-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.shop-content { min-width: 0; flex: 1; }
.shop-section { display: flex; justify-content: space-between; align-items: center; margin: 8rpx 4rpx 20rpx; font-size: 30rpx; font-weight: 600; }.shop-section text { color: #8a9788; font-size: 23rpx; font-weight: 400; }
.category-collapsed .category-sidebar { width: 78rpx; flex-basis: 78rpx; }
.category-collapsed .category-side-item { justify-content: center; padding: 10rpx 4rpx; }
.category-collapsed .category-side-name { display: none; }
.exchange-note { background: #e4f2e5; color: #4d7d54; border-radius: 18rpx; padding: 18rpx 22rpx; font-size: 23rpx; margin-bottom: 20rpx; }
