.shop-heading { margin: 8rpx 4rpx 28rpx; }.shop-heading .title { font-size: 40rpx; }.shop-heading .muted { margin-top: 8rpx; }
.category-page { height: 100vh; min-height: 0; display: flex; flex-direction: column; overflow: hidden; padding-top: 0; }
.category-page > .search-box { flex-shrink: 0; height: 64rpx; box-sizing: border-box; padding: 0 22rpx; }
.category-page > .search-box input { height: 60rpx; }
.category-page > .shop-top-ad { flex-shrink: 0; }
.shop-layout { display: grid; grid-template-columns: 168rpx minmax(0, 1fr); grid-template-rows: auto minmax(0, 1fr); align-items: stretch; flex: 1; min-height: 0; column-gap: 18rpx; margin-top: 16rpx; }
.category-sidebar { width: 168rpx; flex: 0 0 168rpx; min-height: 0; display: flex; flex-direction: column; }
.category-sidebar-head { display: flex; align-items: center; justify-content: flex-end; min-height: 42rpx; box-sizing: border-box; padding: 4rpx 0; flex-shrink: 0; margin-bottom: 6rpx; }
.category-sidebar-title { flex: 1; padding-left: 10rpx; color: #718373; font-size: 24rpx; font-weight: 600; }
.category-toggle { flex: 0 0 58rpx; width: 58rpx; height: 34rpx; margin: 0; padding: 0; background: transparent; display: flex; align-items: center; justify-content: center; line-height: 1; }
.category-toggle-pressed { transform: scale(.97); opacity: .85; }
.category-toggle-icon { color: #32815a; font-size: 34rpx; line-height: 1; font-weight: 400; }
.category-scroll { height: 0; flex: 1; min-height: 0; padding: 0; box-sizing: border-box; }
.category-side-item { min-height: 76rpx; margin-bottom: 10rpx; padding: 10rpx 8rpx; box-sizing: border-box; border-radius: 18rpx; display: flex; align-items: center; gap: 8rpx; background: #fff; color: #718373; font-size: 22rpx; }
.category-side-item.active { background: #009e60; color: #fff; font-weight: 600; box-shadow: 0 6rpx 16rpx rgba(0, 158, 96, .18); }
.category-side-icon { width: 38rpx; height: 38rpx; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: #edf6ed; color: #258b5a; font-size: 21rpx; flex: 0 0 38rpx; }
.category-side-item.active .category-side-icon { background: rgba(255,255,255,.2); color: #fff; }
.category-side-name { flex: 1; min-width: 0; white-space: normal; overflow-wrap: break-word; }
.shop-content { min-width: 0; min-height: 0; flex: 1; display: flex; flex-direction: column; }
.shop-section { display: flex; justify-content: space-between; align-items: center; min-height: 42rpx; box-sizing: border-box; padding: 4rpx 0; flex-shrink: 0; margin: 0 4rpx 6rpx; font-size: 30rpx; line-height: 34rpx; font-weight: 600; }.shop-section text { color: #8a9788; font-size: 23rpx; font-weight: 400; }
.product-scroll { height: 0; flex: 1; min-height: 0; }
.pagination-status { padding: 20rpx 4rpx; color: #819184; font-size: 22rpx; text-align: center; }
.pagination-status button { margin-top: 12rpx; }
.category-collapsed .category-sidebar { width: 78rpx; flex-basis: 78rpx; }
.shop-layout.category-collapsed { grid-template-columns: 78rpx minmax(0, 1fr); }
.category-collapsed .category-side-item { justify-content: center; padding: 10rpx 4rpx; }
.category-collapsed .category-side-name { display: none; }
.exchange-note { background: #e4f2e5; color: #4d7d54; border-radius: 18rpx; padding: 18rpx 22rpx; font-size: 23rpx; margin-bottom: 20rpx; }

/* Keep category cards compact; reserve a separate row for purchase controls. */
.shop-content .product-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; }
.shop-content .product-tile { box-sizing: border-box; padding: 8rpx 8rpx 92rpx; border-radius: 20rpx; }
.shop-content .product-photo { height: 216rpx; border-radius: 14rpx; background: #fff; }
.shop-content .product-info { padding: 12rpx 6rpx 8rpx; }
.shop-content .product-name { height: 72rpx; font-size: 24rpx; line-height: 36rpx; }
.shop-content .product-meta { font-size: 20rpx; min-height: 30rpx; margin: 6rpx 0 10rpx; }
.shop-content .gift-note { white-space: normal; line-height: 30rpx; overflow-wrap: break-word; }
.shop-content .regular-price { font-size: 21rpx; line-height: 30rpx; margin: 6rpx 0 10rpx; }
.shop-content .product-bottom { align-items: flex-start; }
.shop-content .product-price { max-width: 100%; font-size: 25rpx; overflow-wrap: anywhere; }
.shop-content .member-highlight { width: 100%; min-height: 58rpx; padding: 10rpx 8rpx; font-size: 27rpx; border-radius: 8rpx; box-shadow: none; }
.shop-content .price-label { font-size: 21rpx; }
.shop-content .product-stepper { right: 14rpx; bottom: 14rpx; height: 64rpx; min-height: 64rpx; padding: 0; gap: 4rpx; max-width: calc(100% - 28rpx); box-sizing: border-box; }
.shop-content .product-stepper button { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 64rpx; min-width: 64rpx; height: 64rpx; line-height: 1; font-size: 38rpx; }
.shop-content .step-count { display: flex; align-items: center; justify-content: center; min-width: 28rpx; height: 64rpx; font-size: 22rpx; line-height: 1; white-space: nowrap; }
.shop-content .gift-buy-button { left: 14rpx; right: 14rpx; bottom: 12rpx; width: auto; min-width: 0; max-width: calc(100% - 28rpx); height: 52rpx; line-height: 52rpx; padding: 0 6rpx; box-sizing: border-box; margin: 0; border-radius: 12rpx; font-size: 23rpx; }
.shop-section > view { flex: 1; min-width: 0; overflow-wrap: break-word; }
.shop-section > text { flex-shrink: 0; margin-left: 12rpx; }
