.category-page{padding-top:32rpx}.header{padding:0 8rpx 24rpx}.categories{display:flex;gap:14rpx;overflow:hidden;white-space:nowrap;margin-bottom:24rpx}.categories view{background:#fff;border-radius:32rpx;padding:14rpx 24rpx;color:#64748b;font-size:25rpx}.categories .active{background:#10b981;color:#fff}.sort{display:flex;justify-content:space-between;align-items:center;margin:16rpx 8rpx;font-weight:700}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20rpx}.product{padding:0 0 24rpx;overflow:hidden}.cover{height:200rpx;background:#f1f5f9;display:flex;align-items:center;justify-content:center;font-size:86rpx}.name{padding:16rpx 20rpx 0;font-weight:600}.product .muted{padding:8rpx 20rpx 0}.price{padding:12rpx 20rpx 0;color:#10b981;font-weight:700}.empty{text-align:center;color:#94a3b8;padding:100rpx 0}
