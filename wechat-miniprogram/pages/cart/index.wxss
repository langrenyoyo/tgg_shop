.cart-page { padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); }
.cart-heading { margin: 8rpx 4rpx 28rpx; }.cart-heading .title { font-size: 40rpx; }.cart-heading .muted { margin-top: 8rpx; }
.cart-item { display: flex; gap: 18rpx; padding: 24rpx 20rpx; align-items: center; }.cart-selection { padding: 12rpx 0; flex-shrink: 0; }.check-circle { width: 34rpx; height: 34rpx; border-radius: 50%; border: 2rpx solid #cfdbcc; text-align: center; line-height: 34rpx; font-size: 24rpx; }.check-circle.checked { color: #fff; border-color: #00a865; background: #00a865; }
.cart-photo { width: 160rpx; height: 180rpx; border-radius: 20rpx; flex-shrink: 0; background: #f0f5ec; }.cart-photo-empty { display: flex; align-items: center; justify-content: center; color: #94a08c; font-size: 22rpx; }.cart-content { flex: 1; min-width: 0; }.cart-name { font-size: 27rpx; font-weight: 600; overflow-wrap: anywhere; }.cart-category { color: #8c9a85; font-size: 21rpx; margin-top: 6rpx; }.cart-price { color: #00945b; font-size: 29rpx; font-weight: 700; margin-top: 10rpx; }.cart-controls { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; margin-top: 14rpx; }.stepper { display: flex; align-items: center; border: 1rpx solid #e3eadf; border-radius: 12rpx; overflow: hidden; }.stepper button { margin: 0; padding: 0; width: 48rpx; height: 48rpx; line-height: 44rpx; font-size: 30rpx; color: #456940; background: #f2f6ef; border-radius: 0; }.stepper text { padding: 0 16rpx; font-size: 24rpx; }.remove-button { margin: 0; padding: 0 4rpx; background: transparent; color: #91a08a; font-size: 22rpx; line-height: 48rpx; flex-shrink: 0; }
.empty-cart { text-align: center; padding: 96rpx 16rpx; }.empty-cart-icon { width: 156rpx; height: 156rpx; margin: 0 auto 32rpx; border-radius: 50%; background: #e4f0de; display: flex; align-items: center; justify-content: center; }.empty-cart-icon image { width: 80rpx; height: 80rpx; }.empty-cart .muted { margin: 16rpx 0 36rpx; }.empty-cart navigator { display: inline-block; padding: 22rpx 48rpx; }
.checkout-bar { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; border-top: 1rpx solid #e9efe4; padding: 24rpx 28rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; justify-content: space-between; gap: 20rpx; z-index: 5; }.checkout-note { font-size: 26rpx; font-weight: 600; flex: 1; min-width: 0; }.checkout-note text { display: block; font-weight: 400; font-size: 19rpx; color: #8c9a84; margin-top: 6rpx; }.checkout-bar button { margin: 0; flex-shrink: 0; padding: 22rpx 40rpx; }
