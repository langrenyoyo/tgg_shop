<view class="page"><view class="title">购物车</view>
<view wx:if="{{error}}">{{error}}<button bindtap="load">重试</button></view>
<view class="card" wx:for="{{items}}" wx:key="productId">
<view bindtap="select" data-id="{{item.productId}}">{{item.selected ? '☑' : '□'}} {{item.product.name || '商品已下架'}}</view>
<view wx:if="{{item.product}}">{{item.product.supportsPoints ? item.product.pointsPrice + ' 积分' : '¥' + item.product.cashPrice}}</view>
<view class="row"><button data-id="{{item.productId}}" data-delta="-1" bindtap="quantity">－</button><text>{{item.quantity}}</text><button data-id="{{item.productId}}" data-delta="1" bindtap="quantity">＋</button><button data-id="{{item.productId}}" bindtap="remove">移除</button></view>
</view><view wx:if="{{loading}}">正在加载购物车</view><view wx:if="{{!loading && !error && !items.length}}" class="card">购物车为空</view>
<button wx:if="{{items.length}}" bindtap="checkout" disabled="{{loading || error}}" class="btn btn-primary">去结算</button></view>
