<view class="station-page">
  <view wx:if="{{error}}" class="error-card">{{error}}<button bindtap="load">重新加载</button></view>
  <view class="station-head"><view><view class="eyebrow">站点工作台</view><view class="title">{{siteName}}</view><view class="muted">{{station.name || '站点工作人员'}}</view></view><button class="logout" bindtap="logout">退出</button></view>
  <view class="stats"><view><text>待收货</text><text>{{counts.pendingReceive || 0}}</text></view><view><text>待提货</text><text>{{counts.readyPickup || 0}}</text></view><view><text>异常</text><text>{{counts.exceptions || 0}}</text></view></view>
  <view class="tabs"><button data-view="receive" bindtap="switchView">待收货</button><button data-view="pickup" bindtap="switchView">待提货</button><button data-view="exceptions" bindtap="switchView">异常跟进</button></view>
  <view wx:if="{{!canReceive && !canPickup && !canException}}" class="muted">当前账号仅可查看，操作权限请联系管理员配置。</view>
  <view wx:if="{{!current && !pickupPreview && ((view === 'receive' && canReceive) || (view === 'pickup' && canPickup))}}" class="card quick"><button bindtap="scan" disabled="{{busy}}" data-target="{{view === 'receive' ? 'orderId' : 'pickupCode'}}">{{view === 'receive' ? '扫码查单' : '扫码找货'}}</button><button class="light" disabled="{{busy}}" bindtap="manual">{{view === 'receive' ? '手动输入' : '输入提货码'}}</button></view>
  <view wx:if="{{summary.length && !current}}" class="card"><view>多单商品汇总（按站点分别备货，逐单核对分装）</view><view wx:for="{{summary}}" wx:key="key">{{item.siteName}} · {{item.locationCode}} · {{item.title}} × {{item.quantity}}</view></view>
  <view wx:if="{{pendingPickup}}" class="card">上次提货结果待确认。<button bindtap="retryPickup" disabled="{{busy}}">重试原提货核验</button></view>
  <view wx:if="{{pickupPreview}}" class="card pickup-find">
    <view class="eyebrow">找到货物后，再确认交付</view>
    <view class="title">{{pickupPreview.order.siteName}}</view>
    <view class="items">订单 {{pickupPreview.order.id}}</view>
    <view class="pickup-total">共 {{pickupPreview.order.bagCount}} 袋 · {{pickupPreview.order.itemCount}} 件商品</view>
    <checkbox-group bindchange="pickupCheck">
      <label wx:for="{{pickupPreview.order.packages}}" wx:key="id" class="pickup-location">
        <view class="pickup-location-main"><text class="tag">{{item.storageLabel}}</text><view class="pickup-shelf">{{item.shelfCode}}</view><view>{{item.bagCount}} 袋<text wx:if="{{item.legacy}}">（历史订单，请现场核实袋数）</text></view></view>
        <checkbox value="{{item.id}}" disabled="{{busy || pendingPickup}}" color="#078052"/>已取齐
      </label>
    </checkbox-group>
    <view class="items" wx:for="{{pickupPreview.order.items}}" wx:key="productId">{{item.title || item.name || item.productId}} × {{item.quantity}}</view>
    <view wx:if="{{pickupPreview.order.overdue}}" class="error-card">已超过保管期限，请先检查商品状态</view>
    <view class="muted">逐项核对存放位、包装标签、袋数及商品，交给用户后确认。</view>
    <button class="pickup-confirm" bindtap="confirmPickup" disabled="{{busy || !pickupReady || pendingPickup}}" loading="{{busy}}">确认已交付</button>
    <button class="pickup-cancel" bindtap="cancelPickup" disabled="{{busy || pendingPickup}}">返回找货</button>
  </view>
  <view wx:if="{{current}}" class="card">
    <view>核对收货：{{current.id}}</view>
    <view wx:for="{{checkItems}}" wx:key="productId" class="card">
      <view>{{item.title}} · 应收 {{item.quantity}}</view><view>库位 {{item.locationCode}} · {{item.storageType}}</view><view wx:if="{{item.backupLocation}}">备用库位 {{item.backupLocation}}</view>
      <input type="number" value="{{item.actualQuantity}}" data-index="{{index}}" bindinput="quantity" disabled="{{busy || pendingReceive}}" placeholder="输入实收数量"/>
      <button bindtap="scanProduct" data-index="{{index}}" disabled="{{busy || pendingReceive}}">{{item.scannedBarcode ? '条码已核对' : '扫码核对商品'}}</button>
    </view>
    <view class="items">分袋存放（每袋请贴订单尾号和位置标签）</view>
    <view wx:for="{{packageRows}}" wx:key="index" class="package-editor">
      <picker range="{{storageLabels}}" value="{{item.typeIndex}}" data-index="{{index}}" data-field="typeIndex" bindchange="packageField" disabled="{{busy || pendingReceive}}"><view class="package-picker">存放类型：{{storageLabels[item.typeIndex]}} ›</view></picker>
      <view class="muted">实际存放位置</view><input value="{{item.shelfCode}}" maxlength="40" data-index="{{index}}" data-field="shelfCode" bindinput="packageField" disabled="{{busy || pendingReceive}}" placeholder="如 A-02-03；常温可留空自动分配"/>
      <view class="muted">袋数</view><input type="number" value="{{item.bagCount}}" data-index="{{index}}" data-field="bagCount" bindinput="packageField" disabled="{{busy || pendingReceive}}" placeholder="此位置有几袋"/>
      <button wx:if="{{packageRows.length > 1}}" bindtap="removePackage" data-index="{{index}}" disabled="{{busy || pendingReceive}}">移除此位置</button>
    </view>
    <button wx:if="{{packageRows.length < 12}}" bindtap="addPackage" disabled="{{busy || pendingReceive}}">＋ 添加存放位置</button>
    <view wx:if="{{pendingReceive}}">提交结果待确认，请重试原收货单。</view>
    <button wx:if="{{canReceive}}" bindtap="confirmReceive" disabled="{{busy}}">{{pendingReceive ? '重试确认' : '确认收货上架'}}</button><button wx:if="{{canException}}" bindtap="exception" disabled="{{busy || pendingReceive}}">上报异常</button><button bindtap="release" disabled="{{busy || pendingReceive}}">释放任务</button>
  </view>
  <view wx:for="{{orders}}" wx:if="{{!pickupPreview}}" wx:key="id" class="card order"><view class="order-top"><text>{{item.id}}</text><text class="tag">{{item.stationStatus}}</text></view><view class="items">{{item.itemsText}}</view><view class="muted">提货位：{{item.shelfCode || '待分配'}}</view><view wx:for="{{item.packages}}" wx:for-item="pack" wx:key="id" class="items">{{pack.storageLabel}} · {{pack.shelfCode}} · {{pack.bagCount}} 袋</view><view wx:if="{{item.holdUntil}}">保管期限：{{item.holdUntil}}{{item.overdue ? '（已超时，请跟进）' : ''}}</view><view wx:if="{{item.exceptionRemark}}">异常：{{item.exceptionRemark}}</view><view wx:if="{{item.pickerId}}">拣货员：{{item.pickerId}}</view>
    <view wx:for="{{item.pickingItems}}" wx:for-item="goods" wx:key="productId">{{goods.locationCode}} · {{goods.title}} × {{goods.quantity}} <text wx:if="{{goods.backupLocation}}">备用：{{goods.backupLocation}}</text></view>
    <button wx:if="{{canReceive && (item.stationStatus === 'expected' || item.stationStatus === 'in_transit' || item.stationStatus === 'picking' || item.stationStatus === 'exception')}}" bindtap="receive" data-id="{{item.id}}" disabled="{{busy || current || !pickingConfig.enabled}}">领取并核对收货</button><button wx:if="{{canPickup && (item.stationStatus === 'ready' || item.stationStatus === 'received')}}" bindtap="pickup" data-id="{{item.id}}" disabled="{{busy || current}}">核验提货</button><button wx:if="{{canException}}" bindtap="exception" data-id="{{item.id}}" disabled="{{busy || pendingReceive}}">登记异常</button>
  </view>
  <view wx:if="{{!loading && !orders.length}}" class="empty">暂无订单</view>
</view>
