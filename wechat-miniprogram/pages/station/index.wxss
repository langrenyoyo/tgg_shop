.station-page { min-height:100vh; padding:28rpx; box-sizing:border-box; background:#f4f8f5; }.station-head { display:flex; justify-content:space-between; align-items:flex-start; padding:18rpx 0 30rpx; }.eyebrow { color:#078052; font-size:22rpx; letter-spacing:2rpx; }.title { margin-top:10rpx; color:#19392d; font-size:40rpx; font-weight:800; }.muted { color:#74847b; font-size:23rpx; }.logout { margin:0; padding:12rpx 22rpx; color:#078052; background:#e1f4e9; font-size:23rpx; border-radius:999rpx; }.stats { display:flex; gap:16rpx; margin-bottom:20rpx; }.stats view { flex:1; padding:22rpx; background:#fff; border-radius:20rpx; }.stats text { display:block; color:#7d8c83; font-size:22rpx; }.stats text:last-child { display:block; margin-top:10rpx; color:#078052; font-size:42rpx; }.tabs { display:flex; gap:12rpx; margin-bottom:18rpx; }.tabs button { flex:1; color:#678075; background:#e5eee8; border-radius:14rpx; }.tabs button.active { color:#fff; background:#078052; }.card { margin-bottom:16rpx; padding:24rpx; background:#fff; border-radius:20rpx; box-shadow:0 8rpx 24rpx rgba(15,71,42,.06); }.quick { display:flex; gap:12rpx; }.quick button,.order button { flex:1; color:#fff; background:#078052; border-radius:12rpx; }.quick button.light { color:#078052; background:#e5f3e9; }.order-top { display:flex; justify-content:space-between; font-weight:700; }.tag { padding:5rpx 12rpx; color:#9a6815; background:#fff1d2; border-radius:999rpx; font-size:20rpx; }.items { margin:18rpx 0; color:#2d4539; }.order button { margin-top:18rpx; }.empty,.error-card { padding:30rpx; text-align:center; color:#7b8a82; }.error-card { margin-bottom:18rpx; color:#a33b2f; background:#fff0ed; border-radius:16rpx; }
.pickup-find { border: 2rpx solid #b6dfc7; }
.pickup-total { margin: 20rpx 0; font-size: 32rpx; font-weight: 700; color: #087b4f; }
.pickup-location { display: flex; align-items: center; gap: 12rpx; margin: 18rpx 0; padding: 24rpx; border-radius: 18rpx; background: #edf7f0; font-size: 24rpx; }
.pickup-location-main { flex: 1; min-width: 0; }
.pickup-shelf { margin: 12rpx 0; color: #087b4f; font-size: 48rpx; line-height: 1.3; font-weight: 800; word-break: break-all; }
.station-page .pickup-confirm, .station-page .pickup-cancel { width: 100%; margin-top: 20rpx; padding: 20rpx 12rpx; font-size: 28rpx; line-height: 1.5; border-radius: 16rpx; }
.station-page .pickup-confirm { background: #078052; color: #fff; }
.station-page .pickup-cancel { background: #edf5ef; color: #426252; }
.package-editor { padding: 22rpx; margin: 20rpx 0; border: 1rpx solid #d9e8de; border-radius: 18rpx; }
.package-picker { margin-bottom: 18rpx; padding: 16rpx; background: #edf5ef; border-radius: 12rpx; }
.station-page .package-editor input { box-sizing: border-box; width: 100%; height: 88rpx; padding: 0 18rpx; margin: 12rpx 0 20rpx; border: 1rpx solid #d9e8de; border-radius: 12rpx; font-size: 26rpx; background: #fff; }
