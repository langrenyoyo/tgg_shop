.customer-service-page { min-height: 100vh; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.customer-service-heading { padding: 18rpx 8rpx 28rpx; }
.customer-service-heading .title { font-size: 40rpx; }
.customer-service-subtitle { margin-top: 10rpx; color: #65786a; font-size: 26rpx; }
.qr-panel { padding: 36rpx 28rpx; border-radius: 24rpx; background: #fff; text-align: center; }
.qr-instruction { color: #22352a; font-size: 30rpx; font-weight: 600; }
.customer-service-qr { display: block; width: 500rpx; max-width: 100%; height: 500rpx; margin: 30rpx auto 0; }
.qr-status { min-height: 280rpx; display: flex; align-items: center; justify-content: center; padding: 30rpx; color: #7a887d; font-size: 26rpx; line-height: 1.6; }
.retry-button { margin-top: 20rpx; }
.contact-button { width: 100%; min-height: 88rpx; margin-top: 24rpx; }
