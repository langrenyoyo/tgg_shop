<view class="page customer-service-page">
  <view class="customer-service-heading">
    <view class="title">企业客服</view>
    <view class="customer-service-subtitle">获取更高收益，请添加企业客服</view>
  </view>
  <view class="qr-panel">
    <view class="qr-instruction">长按二维码，添加企业微信</view>
    <view class="qr-tip">可点击查看原图。如长按未出现识别入口，请保存二维码后，打开微信扫一扫 → 相册识别。</view>
    <view wx:if="{{loading}}" class="qr-status">二维码加载中…</view>
    <image wx:elif="{{qrCode}}" class="customer-service-qr" src="{{qrCode}}" data-src="{{qrCode}}" mode="widthFix" show-menu-by-longpress="{{true}}" bindtap="preview" binderror="imageError" aria-label="企业微信二维码，点击放大或长按识别"/>
    <view wx:else class="qr-status">{{error}}</view>
    <button wx:if="{{error}}" class="btn btn-light retry-button" bindtap="load">重新加载</button>
    <button wx:if="{{qrCode && !loading}}" class="btn btn-light retry-button" bindtap="saveQr" loading="{{saving}}" disabled="{{saving}}">保存二维码</button>
  </view>
</view>
