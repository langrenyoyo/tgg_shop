<view class="page">
  <view class="card" wx:if="{{error}}">{{error}}<button bindtap="load">重新加载</button></view>
  <view class="card">
    <view class="row">
      <view>
        <view class="title">{{loading ? '加载中' : user.nickname || (loggedIn ? '账号信息待刷新' : '未登录')}}</view>
        <view wx:if="{{user.id}}" class="muted">积分 {{user.points || 0}}</view>
      </view>
      <button wx:if="{{!loggedIn}}" class="btn btn-light" bindtap="goLogin">登录</button>
    </view>
  </view>

  <view class="card">
    <view class="list-item" bindtap="goOrders">订单</view>
    <view class="list-item" bindtap="goMembership">会员权益与续费</view>
    <view class="list-item" bindtap="goPoints">积分流水</view>
    <view class="list-item" bindtap="goInvite">邀请</view>
  </view>

  <view class="card" wx:if="{{loggedIn}}">
    <button class="btn btn-light" bindtap="logout" loading="{{loggingOut}}" disabled="{{loggingOut}}">退出登录</button>
  </view>
</view>
