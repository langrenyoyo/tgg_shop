<view class="page">
  <view class="card">
    <view class="row">
      <view>
        <view class="title">{{user.nickname || '未登录'}}</view>
        <view class="muted">积分 {{user.points || 0}}</view>
      </view>
      <button class="btn btn-light" bindtap="goLogin">登录</button>
    </view>
  </view>

  <view class="card">
    <view class="list-item" bindtap="goOrders">订单</view>
    <view class="list-item" bindtap="goPoints">积分流水</view>
    <view class="list-item" bindtap="goInvite">邀请</view>
  </view>

  <view class="card">
    <button class="btn btn-light" bindtap="logout">退出登录</button>
  </view>
</view>
