<view class="page profile-page">
  <view class="profile-header"><view class="profile-identity" bindtap="openProfile"><image wx:if="{{avatarPreview}}" class="profile-avatar" src="{{avatarPreview}}" mode="aspectFill" /><view wx:else class="profile-avatar default-avatar"><image src="/assets/icons/me-active.png"/></view><view class="profile-copy"><view class="profile-name">{{loading ? '加载中' : user.nickname || (loggedIn ? '账号信息待刷新' : '点击登录')}} <text>›</text></view><view class="profile-subtitle">新鲜日常，积分相伴</view></view></view><view class="header-tool" bindtap="goService" data-type="customerService"><image src="/assets/icons/orders.png"/><text>客服</text></view><view class="header-tool" bindtap="goService" data-type="feedback"><image src="/assets/icons/tasks.png"/><text>反馈</text></view></view>
  <view class="member-card"><view class="member-heading" bindtap="goMembership"><view class="member-title"><image src="/assets/icons/member.png"/><text>TGG 会员</text></view><view class="member-action">{{user.isMember ? '查看权益' : '立即开通'}} ›</view></view><view class="member-caption">{{user.isMember ? '会员权益已开启，让日常更美好' : '开通月会员，解锁更多购物方式'}}</view><view class="benefit-grid" bindtap="goMembership"><view class="benefit benefit-main"><text class="benefit-tag">会员购物</text><view class="benefit-title">新鲜好物随心购</view><text class="benefit-note">解锁现金购物权益</text><image src="/assets/icons/cart-active.png"/></view><view class="benefit"><text class="benefit-tag">灵活支付</text><image src="/assets/icons/member.png"/><view class="benefit-small">积分＋现金</view></view><view class="benefit"><text class="benefit-tag">任务权益</text><image src="/assets/icons/gift.png"/><view class="benefit-small">做任务赚积分</view></view></view></view>
  <view class="panel asset-grid"><view bindtap="goPoints"><view class="asset-value">{{loading ? '…' : user.id ? (user.points || 0) : '—'}}</view><text>我的积分</text></view><view bindtap="goService" data-type="withdraw"><view class="asset-value">{{loading ? '…' : user.id ? (user.withdrawableBalance || 0) : '—'}}</view><text>可提现(元)</text></view><view bindtap="goService" data-type="payments"><view class="asset-value asset-word">账单</view><text>支付记录</text></view><view bindtap="goMembership"><view class="asset-value asset-word">{{user.id ? (user.isMember ? '已开通' : '未开通') : '—'}}</view><text>我的会员</text></view></view>
  <view class="panel order-grid"><view wx:for="{{orderEntries}}" wx:key="filter" class="grid-item" bindtap="goOrders" data-filter="{{item.filter}}"><image src="/assets/icons/{{item.icon}}.png"/><text>{{item.label}}</text></view></view>
  <view class="panel activity-grid"><view class="activity-item" bindtap="goSignin"><view class="activity-icon coral"><image src="/assets/icons/calendar.png"/></view><text>每日签到</text></view><view class="activity-item" bindtap="goTasks"><view class="activity-icon pink"><image src="/assets/icons/tasks-active.png"/></view><text>任务赚积分</text></view><view class="activity-item" bindtap="goInvite"><view class="activity-icon green"><image src="/assets/icons/gift.png"/></view><text>邀请好友</text></view><view class="activity-item" bindtap="goPoints"><view class="activity-icon gold"><image src="/assets/icons/member.png"/></view><text>积分明细</text></view></view>
  <view class="panel services-panel"><view class="panel-title">我的服务</view><view class="service-grid"><view class="grid-item" bindtap="goService" data-type="customerService"><image src="/assets/icons/orders.png"/><text>在线客服</text></view><view class="grid-item" bindtap="goMembership"><image src="/assets/icons/member.png"/><text>会员中心</text></view><view class="grid-item" bindtap="goService" data-type="withdraw"><image src="/assets/icons/gift.png"/><text>余额提现</text></view><view class="grid-item" bindtap="goAddress"><image src="/assets/icons/home.png"/><text>收货地址</text></view><view class="grid-item" bindtap="goService" data-type="payments"><image src="/assets/icons/orders.png"/><text>支付记录</text></view><view class="grid-item" bindtap="goService" data-type="ranking"><image src="/assets/icons/tasks.png"/><text>积分排行</text></view><view class="grid-item" bindtap="goService" data-type="pickupSite"><image src="/assets/icons/shop.png"/><text>自提站点</text></view><view class="grid-item" bindtap="goStation"><image src="/assets/icons/shop-active.png"/><text>站点工作台</text></view><view class="grid-item" bindtap="openProfile"><image src="/assets/icons/me.png"/><text>个人资料</text></view><view class="grid-item" bindtap="goService" data-type="feedback"><image src="/assets/icons/tasks-active.png"/><text>意见反馈</text></view></view></view>
  <view class="cooperation-banner" bindtap="goService" data-type="business"><view><text class="cooperation-kicker">TGG SHOP · 新鲜生活，共同创造</text><view class="cooperation-title">供应商合作</view><text class="cooperation-note">欢迎优质产品供应商与我们联系</text></view><view class="cooperation-action">合作 咨询 ›</view></view>
  <button wx:if="{{loggedIn}}" class="logout-button" bindtap="logout" loading="{{loggingOut}}" disabled="{{loggingOut}}">退出登录</button><view class="profile-footer">TGG SHOP · 让日常多一点美好</view>
</view>
