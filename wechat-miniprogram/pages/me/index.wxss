.profile-page { background: linear-gradient(180deg, #e4f1df 0, #f5f8f5 640rpx); }
.auth-notice { padding: 24rpx; margin-bottom: 20rpx; border-radius: 24rpx; background: #fff; color: #5b7452; font-size: 25rpx; line-height: 1.7; }
.auth-notice button { margin: 20rpx 0 0; display: inline-block; padding: 16rpx 30rpx; font-size: 25rpx; }
.profile-header { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 4rpx 36rpx; }
.profile-avatar { width: 108rpx; height: 108rpx; border-radius: 50%; flex-shrink: 0; border: 6rpx solid rgba(255,255,255,.85); }
.default-avatar { display: flex; align-items: center; justify-content: center; background: #d7eacf; }.default-avatar image { width: 58rpx; height: 58rpx; }
.profile-copy { flex: 1; min-width: 0; }.profile-name { font-size: 34rpx; font-weight: 700; overflow-wrap: anywhere; }.profile-subtitle { color: #829177; font-size: 22rpx; margin-top: 10rpx; }
.profile-edit { margin: 0; padding: 10rpx 18rpx; background: rgba(255,255,255,.75); color: #54714b; font-size: 23rpx; line-height: 1.5; border-radius: 999rpx; flex-shrink: 0; }
.balance-card { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; background: linear-gradient(120deg, #086747, #149862); color: #fff; border-radius: 30rpx; padding: 34rpx; }
.balance-label { color: #c7e5cf; font-size: 25rpx; }.balance-value { font-size: 64rpx; font-weight: 700; line-height: 1.4; overflow-wrap: anywhere; }.balance-value text { font-size: 23rpx; font-weight: 400; margin-left: 12rpx; color: #d1e9d5; }.balance-note { font-size: 21rpx; color: #b3d7bc; margin-top: 6rpx; }.balance-link { font-size: 23rpx; flex-shrink: 0; color: #e1f1dc; }
.member-card { display: flex; align-items: center; gap: 16rpx; background: #f4edd8; padding: 24rpx; border-radius: 24rpx; margin-top: 20rpx; color: #796332; }.member-icon image { width: 52rpx; height: 52rpx; display: block; }.member-copy { flex: 1; font-weight: 600; }.member-copy text { display: block; font-size: 21rpx; color: #9b8a62; margin-top: 4rpx; font-weight: 400; }.member-action { font-size: 23rpx; }
.service-card { padding: 0 26rpx; }.service-row { display: flex; align-items: center; gap: 22rpx; padding: 28rpx 0; border-bottom: 1rpx solid #eef3ed; }.service-row:last-child { border: 0; }.service-icon { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; background: #eaf5e8; }.service-icon image { width: 40rpx; height: 40rpx; }.service-icon.warm { background: #faf0df; }.service-copy { flex: 1; font-size: 28rpx; font-weight: 500; }.service-copy text { display: block; font-size: 21rpx; color: #8a9884; margin-top: 6rpx; }.chevron { color: #abb8a7; font-size: 36rpx; }
.logout-button { color: #81907e; background: transparent; font-size: 25rpx; padding: 16rpx; }.profile-footer { text-align: center; color: #a0ad9a; font-size: 19rpx; letter-spacing: 2rpx; margin-top: 24rpx; }
