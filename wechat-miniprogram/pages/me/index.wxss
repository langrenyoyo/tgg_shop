.profile-page{padding:24rpx 16rpx 48rpx;background:linear-gradient(180deg,#7ceba4 0,#24cb79 470rpx,#f5f6fa 510rpx);color:#262d29}.profile-header{display:flex;align-items:center;gap:20rpx;padding:12rpx 8rpx 28rpx}.profile-identity{display:flex;align-items:center;flex:1;gap:16rpx}.profile-avatar{width:88rpx;height:88rpx;border-radius:50%;border:5rpx solid #e5ffeb}.default-avatar{display:flex;align-items:center;justify-content:center;background:#efffdb}.default-avatar image{width:54rpx;height:54rpx}.profile-copy{min-width:0}.profile-name{font-size:32rpx;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.profile-subtitle{font-size:20rpx;color:#36744c;margin-top:6rpx}.header-tool{display:flex;flex-direction:column;align-items:center;font-size:19rpx;gap:4rpx}.header-tool image{width:36rpx;height:36rpx}.member-card{border-radius:30rpx;padding:24rpx 20rpx;background:linear-gradient(125deg,#353735,#101815);color:#f1ceab}.member-heading{display:flex;align-items:center;justify-content:space-between}.member-title{display:flex;align-items:center;gap:10rpx;font-size:33rpx;font-weight:700}.member-title image{width:38rpx;height:38rpx}.member-action{padding:10rpx 25rpx;border-radius:999rpx;background:#f4c4a4;color:#66402a;font-size:25rpx}.member-caption{font-size:20rpx;color:#d6d6ca;margin:10rpx 0 20rpx}.benefit-grid{display:grid;grid-template-columns:1.8fr 1fr 1fr;gap:10rpx}.benefit{border-radius:18rpx;overflow:hidden;background:#fff0e5;color:#7c482c;min-height:176rpx}.benefit-tag{display:inline-block;padding:4rpx 10rpx;background:#d49670;color:#fff8ee;font-size:20rpx}.benefit image{display:block;width:64rpx;height:64rpx;margin:16rpx auto 6rpx}.benefit-title{font-size:26rpx;font-weight:700;margin:20rpx 14rpx 4rpx}.benefit-note{font-size:19rpx;margin-left:14rpx;color:#a97e63}.benefit-small{font-size:20rpx;text-align:center}.panel{background:#fff;border-radius:24rpx;margin-top:16rpx}.asset-grid{display:grid;grid-template-columns:repeat(4,1fr);padding:20rpx 6rpx;text-align:center}.asset-grid text{color:#575b58;font-size:23rpx}.asset-value{font-size:34rpx;font-weight:700;min-height:52rpx}.asset-word{font-size:28rpx;line-height:52rpx}.order-grid,.service-grid{display:grid;grid-template-columns:repeat(5,1fr)}.order-grid{padding:28rpx 0}.grid-item,.activity-item{display:flex;align-items:center;flex-direction:column;gap:14rpx;font-size:23rpx}.grid-item image{width:42rpx;height:42rpx}.activity-grid{display:grid;grid-template-columns:repeat(4,1fr);padding:24rpx 0}.activity-icon{width:58rpx;height:64rpx;border-radius:12rpx;display:flex;align-items:center;justify-content:center}.activity-icon image{width:38rpx;height:38rpx}.coral{background:#ffe0cc}.pink{background:#ffe0e4}.green{background:#d5f5c9}.gold{background:#ffeaca}.services-panel{padding:22rpx 0 28rpx}.panel-title{font-size:26rpx;font-weight:600;padding:0 24rpx 24rpx}.service-grid{row-gap:34rpx}.service-grid .grid-item{font-size:21rpx}.cooperation-banner{margin-top:16rpx;border-radius:24rpx;padding:22rpx 28rpx;display:flex;align-items:center;justify-content:space-between;background:linear-gradient(110deg,#02994f,#09cc67);color:#fff}.cooperation-kicker{color:#c6f5bf;font-size:18rpx}.cooperation-title{font-size:44rpx;font-weight:700;letter-spacing:5rpx;margin:4rpx 0}.cooperation-note{font-size:19rpx;color:#d2ffdf}.cooperation-action{border:2rpx solid #b0f187;border-radius:50%;padding:16rpx 18rpx;color:#e4ff89;font-size:25rpx;text-align:center}.logout-button{color:#849087;background:transparent;font-size:24rpx;margin-top:20rpx}.profile-footer{text-align:center;color:#9aa59e;font-size:18rpx;margin-top:16rpx}
