<view class="page"><view class="title">确认订单</view>
<view wx:if="{{user && !user.isMember}}" class="card">下单需要先购买月会员，会员到期请先续费。<button bindtap="openMembership">购买会员后下单</button></view>
<view wx:if="{{error}}" class="card">{{error}}<button bindtap="load">重试</button></view>
<view wx:if="{{pending}}" class="card">上次提交结果待确认，将按原商品、支付和收货信息重试。<view>{{pending.fulfillmentType === 'delivery' ? pending.deliveryAddress : '自提点：' + pending.pickupSiteId}}</view><button bindtap="submit" disabled="{{busy || loading}}" loading="{{busy}}">重试原订单</button><view wx:if="{{pending.deliveryTimeSlot}}">配送时段：{{pending.deliveryTimeSlot}}</view></view>
<view class="card" wx:for="{{items}}" wx:key="productId">{{item.product.name}} × {{item.quantity}}<block wx:if="{{!item.product.purePointsOnly}}"><view wx:if="{{item.product.regularPrice > 0}}" class="regular-price">零售价 ¥{{item.product.regularPrice}} / 件</view><view class="member-highlight">会员价 ¥{{item.product.cashPrice}} / 件</view></block></view>
<view class="card" wx:if="{{items.length && !pending}}">
<picker range="{{modes}}" range-key="label" value="{{modeIndex}}" bindchange="mode"><view>支付方式：{{modes[modeIndex].label || '暂无可用方式'}}</view></picker>
<radio-group bindchange="fulfillment"><label wx:if="{{config.pickupEnabled}}"><radio value="pickup" checked="{{fulfillmentType === 'pickup'}}"/>自提</label><label wx:if="{{config.deliveryEnabled}}"><radio value="delivery" checked="{{fulfillmentType === 'delivery'}}"/>送货上门</label></radio-group>
<picker wx:if="{{fulfillmentType === 'pickup'}}" range="{{sites}}" range-key="name" value="{{siteIndex}}" bindchange="site"><view>自提点：{{sites[siteIndex].name || '暂无可用站点'}}</view></picker>
<block wx:else>
<textarea value="{{deliveryAddress}}" bindinput="address" placeholder="收货人、手机号、详细地址"/><button bindtap="openAddress">管理收货地址</button>
<picker range="{{config.deliveryTimeSlots}}" value="{{deliverySlotIndex}}" bindchange="deliverySlot" disabled="{{busy}}"><view>配送时段：{{config.deliveryTimeSlots[deliverySlotIndex] || '暂无可用时段'}}</view></picker>
<view class="muted">每日 {{config.deliveryCutoffHour}} 点截单，配送日期以订单确认为准。</view>
</block>
<view>预计使用 {{estimatedPoints}} 积分 + ¥{{estimatedCash}}</view><view class="muted">提交时按最新库存、价格和余额核算</view>
<view wx:if="{{fulfillmentError}}">{{fulfillmentError}}</view>
<button class="btn btn-primary" loading="{{busy || loading}}" disabled="{{busy || loading || error || fulfillmentError || !modes.length}}" bindtap="submit">提交订单</button>
</view></view>
