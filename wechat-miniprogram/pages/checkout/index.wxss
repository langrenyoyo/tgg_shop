.checkout-page { height: 100vh; min-height: 0; padding: 0; overflow: hidden; display: flex; flex-direction: column; }
.checkout-content { flex: 1; min-height: 0; height: 0; }
.checkout-inner { padding: 24rpx; }
.checkout-footer { flex-shrink: 0; box-sizing: border-box; padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid #e2eee5; box-shadow: 0 -6rpx 24rpx rgba(32,59,48,.05); }
.checkout-options { max-height: calc(65vh - 160rpx - env(safe-area-inset-bottom)); overflow-y: auto; }
.checkout-footer > view, .checkout-options > view, .checkout-footer picker, .checkout-footer radio-group { margin-bottom: 12rpx; }
.checkout-footer textarea { box-sizing: border-box; width: 100%; height: 90rpx; min-height: 90rpx; border: 1rpx solid #e2eee5; border-radius: 10rpx; padding: 8rpx; }
.checkout-footer button { margin-top: 12rpx; }
