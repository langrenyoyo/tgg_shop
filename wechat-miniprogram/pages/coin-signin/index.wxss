page{background:#f4f7f2;color:#19392f}.signin-page{padding:28rpx 34rpx 70rpx}.welcome{margin:38rpx 0 28rpx}.heading{font-size:46rpx;font-weight:700}.muted{font-size:24rpx;color:#74877d;margin:12rpx 0}.reward-card{background:#fff;border:1rpx solid #dfe7e0;border-radius:36rpx;text-align:center;padding:42rpx}.coin{width:128rpx;height:128rpx;line-height:128rpx;border:12rpx solid #ecd1a1;border-radius:50%;background:#f6d795;color:#a77123;font-size:52rpx;font-weight:bold;margin:30rpx auto}.reward{font-size:70rpx;font-weight:bold;color:#a4752e;margin:22rpx 0}.reward text{font-size:28rpx;font-weight:normal}.description{font-size:25rpx;color:#74877d;line-height:1.8;margin:20rpx 0 30rpx}.primary{background:#087e59!important;color:#fff!important;border-radius:18rpx;font-size:28rpx}.primary[disabled]{opacity:.45}.fine{font-size:22rpx;color:#74877d;line-height:1.7;text-align:center;margin:22rpx 0}.balance{font-size:25rpx;margin-top:25rpx;color:#526b5e}.badges{font-size:23rpx;color:#74877d;text-align:center;margin:35rpx 0}.ad-slot{overflow:hidden;border-radius:22rpx;margin:24rpx 0}.notice{font-size:24rpx;color:#8b724a;background:#faf6e9;line-height:1.8;padding:22rpx;border-radius:16rpx;margin:22rpx 0;word-break:break-all}.mask{position:fixed;inset:0;z-index:100;background:rgba(25,59,51,.4);display:flex;align-items:center;justify-content:center;padding:36rpx}.dialog{background:#fff;border-radius:40rpx;padding:45rpx;width:100%;box-sizing:border-box;text-align:center;max-height:90vh;overflow:auto}.dialog-title{font-size:36rpx;font-weight:700;line-height:1.5}.symbol{margin:0 auto 28rpx;width:90rpx;height:90rpx;line-height:90rpx;background:#e5f4e8;color:#087e59;border-radius:28rpx;font-size:45rpx}.warning{background:#fbf0df;color:#b0823d}.dots{display:flex;gap:12rpx;flex-wrap:wrap;justify-content:center;margin:26rpx 0}.dot{width:58rpx;height:58rpx;line-height:58rpx;border-radius:50%;background:#edf2ea;color:#74877d;font-size:23rpx}.done{background:#087e59;color:white}.actions{display:flex;gap:20rpx}.actions button{flex:1;font-size:25rpx}.text-button{font-size:24rpx;color:#74877d;background:transparent;margin-top:20rpx}.text-button::after{border:none}
