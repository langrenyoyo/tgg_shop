<view class="page">
  <view class="card member-panel">
    <view class="title">月会员</view>
    <view>购买专区实物商品赠送会员，也可使用积分开通。</view>
    <view>赠送天数以商品说明为准，支付成功后发放，已有会员顺延。</view>
    <view>纯积分兑换无需会员。</view>
    <view>非会员可直接现金购买“买商品送会员”专区商品。</view>
    <button class="btn btn-primary member-open-button" bindtap="goGiftShop" disabled="{{busy}}">买产品送会员</button>
  </view>

  <view wx:if="{{loading}}" class="card loading-panel">正在加载会员信息和待支付订单…</view>
  <view wx:if="{{error}}" class="card error-panel">
    <view>{{error}}</view>
    <button wx:if="{{needLogin}}" bindtap="login">登录</button>
    <button bindtap="load" disabled="{{loading}}">重新加载</button>
  </view>

  <view wx:if="{{user}}" class="card member-panel">
    <view>{{user.isMember ? '会员有效' : '尚未开通或已到期'}}</view>
    <view wx:if="{{user.memberUntil}}">有效期至 {{user.memberUntil}}</view>
    <button wx:if="{{pointsRequired > 0}}" class="btn btn-primary member-open-button" bindtap="subscribe" data-mode="pure_points" disabled="{{busy || loading || error || payments.length}}">
      使用 {{pointsRequired}} 积分开通 30 天
    </button>
  </view>

  <view wx:for="{{payments}}" wx:key="payNo" class="card">
    <view>历史会员订单 {{item.payNo}}</view>
    <view>{{item.metadata.months}} 个月 · ¥{{item.amount}}</view>
    <view>已停止直接付费开通会员。此订单仅供核对付款结果，未付款订单请联系客服处理。</view>
    <button bindtap="queryPayment" data-pay-no="{{item.payNo}}" disabled="{{busy || loading}}">已付款，查询结果</button>
  </view>
</view>
