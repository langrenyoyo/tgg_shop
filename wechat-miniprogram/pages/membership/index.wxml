<view class="page"><view class="card"><view class="title">月会员</view><view>现金购物、积分不足现金补差、会员任务交单</view><view>纯积分兑换无需会员，不支持现金补差。</view></view>
<view wx:if="{{error}}" class="card">{{error}}<button bindtap="login">登录</button><button bindtap="load">重试</button></view>
<view wx:if="{{user}}" class="card"><view>{{user.isMember ? '会员有效' : '尚未开通或已到期'}}</view><view wx:if="{{user.memberUntil}}">有效期至 {{user.memberUntil}}</view><view>¥{{price}} / 月</view><button bindtap="subscribe" data-mode="cash" disabled="{{busy || loading || error || payments.length}}" loading="{{busy}}">{{payments.length ? '请先处理待支付订单' : user.isMember ? '微信续费 30 天' : '微信开通 30 天'}}</button></view>
<button wx:if="{{pointsRequired > 0}}" bindtap="subscribe" data-mode="pure_points" disabled="{{busy || loading || error || payments.length}}">使用 {{pointsRequired}} 积分开通 30 天</button>
<view class="card" wx:for="{{payments}}" wx:key="payNo"><view>待支付会员订单 {{item.payNo}}</view><view>{{item.metadata.months}} 个月 · ¥{{item.amount}}</view><button bindtap="resume" data-pay-no="{{item.payNo}}" disabled="{{busy || loading}}">继续支付</button><button bindtap="queryPayment" data-pay-no="{{item.payNo}}" disabled="{{busy || loading}}">已付款，查询结果</button></view></view>
