.task-submit-page .title { overflow-wrap: anywhere; }
.submit-field { margin-bottom: 24rpx; }
.field-label { margin-bottom: 10rpx; }
/* Native Android inputs need a full text line without vertical padding. */
.submit-field .input { display: block; width: 100%; min-width: 0; box-sizing: border-box; height: 88rpx; min-height: 88rpx; padding: 0 20rpx; line-height: 88rpx; font-size: 30rpx; }
.submit-field .textarea { display: block; width: 100%; box-sizing: border-box; height: 220rpx; min-height: 220rpx; padding: 16rpx 20rpx; line-height: 1.6; font-size: 30rpx; }
.upload-actions { display: flex; gap: 16rpx; margin-top: 12rpx; }
.upload-actions .btn { flex: 1; width: 0; min-width: 0; box-sizing: border-box; margin: 0; padding: 20rpx 12rpx; }
.submit-actions .btn { width: 100%; box-sizing: border-box; margin: 0; white-space: normal; }
.submit-actions .btn + .btn { margin-top: 16rpx; }
