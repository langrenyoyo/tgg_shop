<view class="page">
  <view class="card" wx:if="{{task}}">
    <view class="title">{{task.title}}</view>
    <view class="muted" style="margin-top:8rpx;">按任务要求填写提交字段</view>
    <view wx:if="{{task.rewardValid === false}}">任务奖励待核对，暂不可新提交。<button bindtap="load" disabled="{{loading || uploading}}">刷新任务</button></view>
  </view>

  <view class="card">
    <view wx:for="{{fields}}" wx:key="name" wx:if="{{item.name !== 'imgea' && item.name !== 'images'}}" style="margin-bottom:16rpx;">
      <view class="muted">{{item.label}}</view>
      <input wx:if="{{item.type !== 'textarea'}}" disabled="{{loading || awaitingResult}}" class="input" data-name="{{item.name}}" placeholder="请输入{{item.label}}" value="{{form[item.name]}}" bindinput="onInput" />
      <textarea wx:else class="textarea" disabled="{{loading || awaitingResult}}" data-name="{{item.name}}" placeholder="请输入{{item.label}}" value="{{form[item.name]}}" bindinput="onInput"></textarea>
    </view>

    <view wx:if="{{needImages}}">
      <view class="muted">截图上传</view>
      <view class="grid-2" style="margin-top:12rpx;">
        <button class="btn btn-light" bindtap="chooseImage" disabled="{{uploading || loading || awaitingResult || images.length >= 3}}" loading="{{uploading}}">选择图片</button>
        <button class="btn btn-light" bindtap="clearImages" disabled="{{uploading || loading || awaitingResult}}">清空</button>
      </view>
      <view class="grid-2" style="margin-top:12rpx;">
        <image wx:for="{{images}}" wx:key="*this" src="{{item}}" mode="aspectFill" style="width:100%;height:180rpx;border-radius:12rpx;"></image>
      </view>
    </view>
  </view>

  <view class="card">
    <view wx:if="{{awaitingResult}}">上次提交结果尚未确认，已保留原内容。可用原内容重试或查看记录，请勿另开新单。</view>
    <button class="btn btn-primary" loading="{{loading}}" disabled="{{loading || uploading || (!awaitingResult && (!task || task.paused || task.rewardValid === false))}}" bindtap="submit">{{awaitingResult ? '重试原提交' : '提交任务'}}</button>
    <button class="btn btn-light" bindtap="openRecords">查看提交记录与审核结果</button>
  </view>
</view>
