<view class="page">
  <view class="card" wx:if="{{task}}">
    <view class="title">{{task.title}}</view>
    <view class="muted" style="margin-top:8rpx;">按任务要求填写提交字段</view>
  </view>

  <view class="card">
    <view wx:for="{{fields}}" wx:key="name" style="margin-bottom:16rpx;">
      <view class="muted">{{item.label}}</view>
      <input wx:if="{{item.type !== 'textarea'}}" class="input" data-name="{{item.name}}" placeholder="请输入{{item.label}}" value="{{form[item.name]}}" bindinput="onInput" />
      <textarea wx:else class="textarea" data-name="{{item.name}}" placeholder="请输入{{item.label}}" value="{{form[item.name]}}" bindinput="onInput"></textarea>
    </view>

    <view wx:if="{{needImages}}">
      <view class="muted">截图上传</view>
      <view class="grid-2" style="margin-top:12rpx;">
        <button class="btn btn-light" bindtap="chooseImage">选择图片</button>
        <button class="btn btn-light" bindtap="clearImages">清空</button>
      </view>
      <view class="grid-2" style="margin-top:12rpx;">
        <image wx:for="{{images}}" wx:key="*this" src="{{item}}" mode="aspectFill" style="width:100%;height:180rpx;border-radius:12rpx;"></image>
      </view>
    </view>
  </view>

  <view class="card">
    <button class="btn btn-primary" loading="{{loading}}" bindtap="submit">提交任务</button>
  </view>
</view>
