.home-page { background: linear-gradient(180deg, #eaf5e9 0, #f5f8f5 720rpx); }
.greet { display: flex; align-items: center; gap: 16rpx; margin: 8rpx 0 28rpx; }
.location-mark { width: 60rpx; height: 60rpx; background: #d9efde; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.location-mark view { width: 20rpx; height: 26rpx; border: 4rpx solid #03995d; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); }
.location-copy { flex: 1; min-width: 0; }
.location-label { font-size: 20rpx; color: #80937b; letter-spacing: 2rpx; }
.location-name { font-size: 32rpx; font-weight: 700; margin-top: 2rpx; }
.location-address { font-size: 22rpx; color: #718574; margin-top: 4rpx; overflow-wrap: break-word; }
.brand-mark { color: #008754; font-size: 30rpx; font-weight: 800; letter-spacing: 2rpx; text-align: center; }
.brand-mark text { display: block; font-size: 15rpx; letter-spacing: 5rpx; }
.hero { margin: 24rpx 0 28rpx; padding: 32rpx; border-radius: 32rpx; background: linear-gradient(120deg, #096546, #179e64); display: flex; align-items: center; gap: 12rpx; overflow: hidden; color: #fff; }
.hero-copy { flex: 1; min-width: 0; position: relative; z-index: 1; }
.hero-kicker { font-size: 17rpx; letter-spacing: 3rpx; color: #bddec8; }
.hero-title { font-size: 44rpx; font-weight: 700; margin: 14rpx 0 8rpx; line-height: 1.25; overflow-wrap: break-word; }
.hero-subtitle { color: #d5edde; font-size: 23rpx; }
.hero-button { margin: 26rpx 0 0; display: inline-flex; align-items: center; gap: 24rpx; background: #eff6d9; color: #175b3d; font-size: 23rpx; line-height: 1.5; padding: 12rpx 24rpx; border-radius: 999rpx; font-weight: 600; }
.hero-button text { font-size: 30rpx; line-height: 1; }
.hero-art { width: 244rpx; height: 244rpx; flex-shrink: 0; position: relative; }
.hero-art image { width: 232rpx; height: 232rpx; border-radius: 50%; border: 6rpx solid rgba(255,255,255,.3); transform: rotate(10deg); }
.hero-stamp { position: absolute; bottom: 0; right: 0; background: #f4e7a4; color: #53633b; border-radius: 999rpx; padding: 8rpx 18rpx; font-size: 20rpx; transform: rotate(-8deg); }
.quick-actions { display: flex; justify-content: space-between; padding: 4rpx 0 24rpx; }
.quick-item { width: 25%; text-align: center; font-size: 25rpx; font-weight: 600; }
.quick-item text { display: block; font-size: 19rpx; color: #8b9988; font-weight: 400; margin-top: 6rpx; }
.quick-icon { margin: 0 auto 12rpx; width: 84rpx; height: 84rpx; display: flex; align-items: center; justify-content: center; border-radius: 28rpx; }
.quick-icon image { width: 46rpx; height: 46rpx; }
.amber { background: #faecd1; }.mint { background: #ddf1e2; }.peach { background: #f9e4d9; }.cream { background: #f0edda; }
.exchange-strip { background: #e5f0de; border: 2rpx solid #dcebd5; border-radius: 24rpx; padding: 24rpx; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.exchange-title { font-size: 26rpx; font-weight: 600; color: #3f653a; }.exchange-subtitle { font-size: 21rpx; color: #849274; margin-top: 6rpx; }
.exchange-action { color: #486d38; font-size: 23rpx; flex-shrink: 0; }
.section-caption { font-size: 21rpx; font-weight: 400; color: #8b9988; margin-top: 4rpx; }
