<view class="page">
  <view class="card">
    <view class="title">TGG Shop</view>
    <view class="muted">用户端首页</view>
  </view>

  <view class="card">
    <view class="row">
      <view>
        <view class="title">{{home.user.nickname || '游客'}}</view>
        <view class="muted">积分 {{home.user.points || 0}}</view>
      </view>
      <button class="btn btn-light" bindtap="goLogin">切换账号</button>
    </view>
  </view>

  <view class="card" wx:if="{{home.deliveryPromise}}">
    <view class="title">{{home.deliveryPromise.title}}</view>
    <view class="muted" style="margin-top:8rpx;">{{home.deliveryPromise.subtitle}}</view>
  </view>

  <view class="card">
    <view class="row">
      <view class="title">热门推荐</view>
      <button class="btn btn-light" bindtap="goTasks">任务页</button>
    </view>
    <view wx:for="{{home.recommendProducts}}" wx:key="id" class="list-item" bindtap="openProduct" data-id="{{item.id}}">
      <view class="row">
        <view>
          <view>{{item.name}}</view>
          <view class="muted">{{item.category}}</view>
        </view>
        <view class="tag">{{item.purePointsOnly ? item.pointsPrice + ' 积分' : '¥' + item.cashPrice}}</view>
      </view>
    </view>
  </view>
</view>
