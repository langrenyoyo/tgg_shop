<view class="page home-page"><view class="greet"><view class="title">{{home.pickupSite.name || 'TGG Shop'}}</view><view>{{home.pickupSite.address}}</view></view>
<input class="search" placeholder="搜索水果、蔬菜" bindconfirm="search" confirm-type="search"/>
<view class="hero"><view><view class="hero-title">{{home.banners[0].title || '时令鲜果季'}}</view><view>{{home.banners[0].subtitle}}</view><button bindtap="goShop">进入商城</button></view></view>
<view class="quick"><view bindtap="goMembership">会员权益与续费</view><view bindtap="goExchange">纯积分兑换</view></view>
<view class="feature"><view class="orange" bindtap="goSignin">签到攒积分</view><view class="blue" bindtap="goTasks">做任务拿积分</view><view class="green" bindtap="goInvite">邀请好友</view></view>
<view wx:if="{{error}}" class="card">{{error}}<button bindtap="load">重试</button></view>
<view class="section-title">热门推荐<text bindtap="goExchange"> · 纯积分专区 ›</text></view>
<view class="products"><view class="product card" wx:for="{{home.recommendProducts}}" wx:key="id" bindtap="openProduct" data-id="{{item.id}}"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" style="width:100%;height:200rpx"/><view>{{item.name}}</view><view class="price">{{item.purePointsOnly ? item.pointsPrice + ' 积分' : '¥' + item.cashPrice}}</view></view></view></view>
