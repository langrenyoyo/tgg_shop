<view class="station-login-page">
  <view class="station-login-hero">
    <view class="station-login-brand">TGG SHOP · STATION</view>
    <view class="station-login-title">站点工作人员授权</view>
    <view class="station-login-subtitle">收货入站 · 用户提货</view>
  </view>
  <view wx:if="{{error}}" class="station-login-error">{{error}}</view>
  <view class="station-login-card">
    <view class="station-login-heading">已绑定微信</view>
    <view class="station-login-description">使用已绑定的微信，快捷进入站点工作台</view>
    <button class="station-login-button station-login-primary" bindtap="wechatLogin" loading="{{loading}}" disabled="{{loading || binding}}" hover-class="station-login-button-hover">微信授权登录</button>
  </view>
  <view class="station-login-card">
    <view class="station-login-heading">首次使用 · 绑定微信</view>
    <view class="station-login-description">输入管理员分配的站点账号，绑定当前微信</view>
    <label class="station-login-field">
      <view class="station-login-label">站点账号</view>
      <input class="station-login-input" placeholder-class="station-login-placeholder" placeholder="请输入站点账号" value="{{username}}" bindinput="onUsername" disabled="{{loading || binding}}" confirm-type="next" />
    </label>
    <label class="station-login-field">
      <view class="station-login-label">登录密码</view>
      <input class="station-login-input" placeholder-class="station-login-placeholder" password placeholder="请输入站点密码" value="{{password}}" bindinput="onPassword" disabled="{{loading || binding}}" confirm-type="done" />
    </label>
    <button class="station-login-button station-login-secondary" bindtap="bindWechat" loading="{{binding}}" disabled="{{loading || binding}}" hover-class="station-login-button-hover">账号登录并绑定微信</button>
  </view>
  <view class="station-login-security">
    <view>站点权限由管理员配置，仅限工作人员使用。</view>
    <view>没有站点账号？请联系管理员开通。</view>
  </view>
</view>
