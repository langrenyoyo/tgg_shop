.station-login-page { min-height:100vh; padding:72rpx 36rpx; box-sizing:border-box; background:linear-gradient(160deg,#e4f3e5,#f7faf5 58%); }
.hero { padding:24rpx 8rpx 42rpx; }.eyebrow { color:#087a4d; font-size:22rpx; letter-spacing:3rpx; font-weight:700; }.title { margin-top:18rpx; font-size:48rpx; font-weight:800; color:#17372c; }.subtitle { margin-top:14rpx; color:#708277; font-size:25rpx; }
.card { padding:30rpx; background:#fff; border-radius:28rpx; box-shadow:0 18rpx 46rpx rgba(18,80,48,.1); }.wechat-btn,.bind-btn { width:100%; border-radius:14rpx; font-size:29rpx; font-weight:700; }.wechat-btn { color:#fff; background:#07a663; }.bind-btn { color:#087a4d; background:#e3f5e9; }.hint,.security { color:#829087; font-size:22rpx; line-height:1.7; }.hint { margin-top:24rpx; text-align:center; }.divider { display:flex; align-items:center; gap:16rpx; margin:30rpx 0 20rpx; color:#a0ada5; font-size:22rpx; }.divider:before,.divider:after { content:""; height:1rpx; flex:1; background:#e8eee9; }.input { box-sizing:border-box; width:100%; margin:16rpx 0; padding:24rpx; border:1rpx solid #dce8df; border-radius:14rpx; background:#fbfdfb; }.error-card { margin-bottom:20rpx; padding:22rpx; border-radius:16rpx; color:#a33b2f; background:#fff0ed; font-size:24rpx; }.security { margin:28rpx 8rpx; }
