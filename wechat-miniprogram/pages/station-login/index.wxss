page { background: #f3f8f4; }
.station-login-page {
  box-sizing: border-box;
  min-height: 100vh;
  max-width: 560px;
  margin: 0 auto;
  padding: 48rpx 32rpx 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: linear-gradient(160deg, #e5f3e9, #f3f8f4 55%);
}
.station-login-hero { padding: 8rpx 8rpx 36rpx; }
.station-login-brand { color: #087a4d; font-size: 21rpx; letter-spacing: 3rpx; font-weight: 700; }
.station-login-title { margin-top: 16rpx; color: #17372c; font-size: 42rpx; line-height: 1.4; font-weight: 700; }
.station-login-subtitle { margin-top: 12rpx; color: #6e8277; font-size: 26rpx; }
.station-login-card { margin-bottom: 24rpx; padding: 32rpx; border: 1rpx solid #e7efe9; border-radius: 28rpx; background: #fff; box-shadow: 0 8rpx 28rpx rgba(18, 80, 48, .04); }
.station-login-heading { color: #203b30; font-size: 30rpx; line-height: 1.5; font-weight: 600; }
.station-login-description { margin-top: 8rpx; color: #74857b; font-size: 24rpx; line-height: 1.7; }
.station-login-field { display: block; margin-top: 24rpx; }
.station-login-label { margin-bottom: 12rpx; color: #425e50; font-size: 25rpx; line-height: 1.5; }
.station-login-input {
  box-sizing: border-box;
  display: block;
  width: 100%;
  height: 92rpx;
  min-height: 92rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dce7df;
  border-radius: 16rpx;
  background: #f8fbf9;
  color: #203b30;
  font-size: 28rpx;
  line-height: normal;
}
.station-login-placeholder { color: #98a69e; }
.station-login-page button.station-login-button {
  box-sizing: border-box;
  display: block;
  width: 100%;
  min-height: 92rpx;
  margin: 28rpx 0 0;
  padding: 24rpx 16rpx;
  border: 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 600;
}
.station-login-page .station-login-primary { color: #fff; background: #07a663; }
.station-login-page .station-login-secondary { color: #087a4d; background: #e6f5ec; }
.station-login-button-hover { opacity: .85; }
.station-login-error { margin-bottom: 24rpx; padding: 24rpx; border-radius: 16rpx; color: #a33b2f; background: #fff0ed; font-size: 25rpx; line-height: 1.6; word-break: break-all; }
.station-login-security { padding: 0 12rpx; color: #829087; font-size: 23rpx; line-height: 1.8; text-align: center; }
