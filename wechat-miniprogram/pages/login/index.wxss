page {
  background: linear-gradient(180deg, #f1f5f9 0%, #f8fafc 55%, #eef2f7 100%);
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 160rpx 32rpx 48rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
}

.card {
  width: 100%;
  box-sizing: border-box;
  margin: 0;
  padding: 40rpx 32rpx 36rpx;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(15, 23, 42, .09);
}

.title { font-size: 38rpx; letter-spacing: .5rpx; }

.input {
  display: block;
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  color: #111827;
  border: 2rpx solid #e2e8f0;
  border-radius: 14rpx;
  background: #f8fafc;
}

.btn { width: 100%; height: 88rpx; line-height: 88rpx; padding: 0; font-size: 32rpx; font-weight: 600; }
