<view class="login-page">
  <view class="brand">TGG Shop</view>
  <block wx:if="{{stage === 'login'}}">
    <view class="heading">微信登录</view>
    <view class="notice">登录时授权微信身份和手机号，用于账号绑定、订单及门店会员关联。头像和昵称由你主动选择，可稍后完善。</view>
    <checkbox-group bindchange="onConsentChange">
      <label class="consent"><checkbox value="agree" checked="{{agreed}}" disabled="{{loading}}" color="#16a34a" /><text>我已阅读并同意以上登录授权说明</text></label>
    </checkbox-group>
    <button class="privacy-link" bindtap="openPrivacy">查看隐私保护指引</button>
    <button class="primary" open-type="{{agreed ? 'getPhoneNumber' : ''}}" bindgetphonenumber="handleLogin" loading="{{loading}}" disabled="{{loading || !agreed}}">手机号授权并微信登录</button>
  </block>
  <block wx:elif="{{stage === 'phone'}}">
    <view class="heading">绑定手机号</view>
    <view class="notice">使用微信验证手机号，完善账号信息，方便订单联系和门店会员关联。</view>
    <button class="privacy-link" bindtap="openPrivacy">查看隐私保护指引</button>
    <button class="primary" open-type="getPhoneNumber" bindgetphonenumber="bindPhone" loading="{{loading}}" disabled="{{loading}}">授权并绑定手机号</button>
  </block>
  <form wx:else bindsubmit="saveProfile">
    <view class="heading">{{editing ? '编辑个人资料' : '完善个人资料'}}</view>
    <button class="avatar-picker" bindtap="chooseAvatarFromAlbum" disabled="{{loading || selectingAvatar}}" aria-label="从相册选择头像">
      <image wx:if="{{avatarPreview}}" class="avatar" src="{{avatarPreview}}" mode="aspectFill" />
      <text wx:else>选择头像</text>
    </button>
    <view class="avatar-actions"><button class="avatar-action" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" disabled="{{loading || selectingAvatar}}">使用微信头像</button><button class="avatar-action" bindtap="chooseAvatarFromAlbum" disabled="{{loading || selectingAvatar}}">相册 / 拍照</button></view>
    <view class="profile-hint">点击头像可选图片；点击昵称输入框可使用微信昵称</view>
    <view class="field-label">昵称</view>
    <input class="nickname" name="nickname" type="nickname" value="{{nickname}}" maxlength="32" placeholder="使用微信昵称或填写昵称" bindinput="onNicknameInput" bindblur="onNicknameInput" disabled="{{loading}}" />
    <view class="phone-binding-row"><view><view class="field-label">手机号</view><view class="phone-binding-value">{{maskedPhone || '尚未绑定'}}</view></view><button wx:if="{{!maskedPhone}}" class="avatar-action" open-type="getPhoneNumber" bindgetphonenumber="bindPhone" disabled="{{loading || selectingAvatar}}">微信授权绑定</button><text wx:else class="phone-binding-status">已绑定</text></view>
    <view wx:if="{{!maskedPhone}}" class="phone-binding-note">经你同意后获取微信验证的手机号，用于账号绑定及门店会员关联。</view>
    <button class="primary" form-type="submit" loading="{{loading}}" disabled="{{loading || selectingAvatar}}">{{editing ? '保存' : '保存并继续'}}</button>
    <button class="secondary" bindtap="skipProfile" disabled="{{loading || selectingAvatar}}">{{editing ? '取消' : '稍后完善'}}</button>
  </form>
  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
