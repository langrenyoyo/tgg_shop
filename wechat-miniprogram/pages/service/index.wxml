<view class="page"><view class="card"><view class="title">{{title}}</view><button class="btn btn-light" bindtap="load">刷新</button></view><view wx:if="{{error}}" class="card">{{error}}<button bindtap="load">重新加载</button></view><view wx:if="{{loading}}" class="card">加载中…</view><block wx:elif="{{type === 'payments'}}"><view wx:for="{{rows}}" wx:key="id" class="card"><view>{{item.payNo || item.id}}</view><view class="muted">{{item.payScene}} · {{item.status}}</view><view>{{item.amount || item.pointAmount || 0}}{{item.amount ? ' 元' : ' 积分'}}</view></view></block><block wx:elif="{{type === 'ranking'}}"><view wx:for="{{rows}}" wx:key="userId" class="card"><view>#{{item.rank}} {{item.nickname}}</view><view class="muted">{{item.userId}}</view><view>{{item.score}} 积分</view></view></block><block wx:elif="{{type === 'withdraw'}}"><view class="card"><view>可提现余额：¥{{balance}}</view><view class="muted">最低 ¥{{config.withdrawMinAmount || 1}}，手续费 {{(config.withdrawFeeRate || 0.01) * 100}}%</view><input type="digit" value="{{amount}}" bindinput="input" placeholder="提现金额"/><button class="btn btn-primary" bindtap="submit" disabled="{{submitting}}">申请提现</button></view><view wx:for="{{rows}}" wx:key="id" class="card"><view>¥{{item.amount}} · {{item.status}}</view></view></block><block wx:elif="{{type === 'pickupSite'}}"><view wx:for="{{rows}}" wx:key="id" class="card"><view class="title">{{item.name}}</view><view>{{item.address}}</view><view class="muted">{{item.contactName}} {{item.contactPhone}}</view></view></block><block wx:else><view wx:for="{{rows}}" wx:key="id" class="card"><view>{{item.subject || title}}</view><view class="muted">{{item.status}}</view><view>{{item.content}}</view></view><view class="card"><textarea value="{{content}}" bindinput="text" placeholder="请填写具体内容"/><button class="btn btn-primary" bindtap="submit" disabled="{{submitting}}">提交</button></view></block><view wx:if="{{!loading && !error && !rows.length && type !== 'withdraw'}}" class="card">暂无记录</view></view>
