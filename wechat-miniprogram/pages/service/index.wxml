<view class="page">
  <view class="card">
    <view class="title">{{title}}</view>
    <button class="btn btn-light" bindtap="load" disabled="{{loading || submitting}}">刷新</button>
  </view>

  <view wx:if="{{error}}" class="card error-panel">
    <view>{{error}}</view>
    <button wx:if="{{needLogin}}" bindtap="login">去登录</button>
    <button bindtap="load" disabled="{{loading}}">重新加载</button>
  </view>
  <view wx:if="{{loading}}" class="card loading-panel">加载中…</view>

  <block wx:elif="{{type === 'payments'}}">
    <view wx:for="{{rows}}" wx:key="id" class="card">
      <view>{{item.payNo || item.id}}</view>
      <view class="muted">{{item.payScene}} · {{item.status}}</view>
      <view>{{item.amount || item.pointAmount || 0}}{{item.amount ? ' 元' : ' 积分'}}</view>
    </view>
  </block>

  <block wx:elif="{{type === 'ranking'}}">
    <view wx:for="{{rows}}" wx:key="userId" class="card">
      <view>#{{item.rank}} {{item.nickname}}</view>
      <view class="muted">{{item.userId}}</view>
      <view>{{item.score}} 积分</view>
    </view>
  </block>

  <block wx:elif="{{type === 'pointExchange'}}">
    <view class="card withdraw-panel">
      <view class="withdraw-label">可用积分</view>
      <view class="withdraw-balance">{{points}} 积分</view>
      <view wx:if="{{!exchangeEnabled}}" class="muted">积分兑换余额暂未开放，请留意后台公告。</view>
      <view wx:else class="withdraw-rules">
        <view>兑换比例：{{config.pointBalanceExchangeRate}} 元/积分</view>
        <view>最低兑换：{{config.pointBalanceExchangeMinPoints}} 积分</view>
        <view>兑换后金额进入可提现余额，可在提现页申请提现。</view>
      </view>
      <input class="withdraw-input" type="number" value="{{exchangeAmount}}" bindinput="exchangeInput" placeholder="请输入兑换积分" />
      <view class="muted">预计增加可提现余额：¥{{exchangePreview}}</view>
      <view wx:if="{{exchangePointsError}}" class="muted">{{exchangePointsError}}</view>
      <button class="btn btn-primary withdraw-submit" bindtap="submit" disabled="{{submitting || loading || error || !exchangeEnabled || exchangePointsError || !exchangeAmount}}" loading="{{submitting}}">兑换余额</button>
    </view>
  </block>

  <block wx:elif="{{type === 'withdraw'}}">
    <view class="card withdraw-panel">
      <view wx:if="{{authorizationRequired !== false}}" class="withdraw-rules">
        <view>微信收款授权：{{authorizationStatus === 'active' ? '已授权' : authorizationStatus === 'pending' ? '等待授权结果' : authorizationStatus === 'expired' ? '已过期，请重新授权' : authorizationStatus === 'revoked' ? '已撤销，请重新授权' : authorizationStatus === 'unknown' ? '待查询' : '尚未确认授权'}}</view>
        <view wx:if="{{authorizationExpiresAt && authorizationStatus === 'active'}}" class="muted">授权有效期至：{{authorizationExpiresAt}}</view>
        <view wx:if="{{authorizationStatus !== 'active'}}" class="muted">{{authorizationMethod === 'urlScheme' ? '复制授权链接，在手机系统浏览器粘贴打开，点击“打开微信授权”。完成后返回本小程序刷新状态。' : authorizationMethod === 'miniProgram' ? '点击按钮前往汇服八方小程序完成收款授权，再返回本小程序。' : '点击按钮，在微信授权窗口确认收款授权。'}}授权结果以刷新后的状态为准。</view>
        <button wx:if="{{authorizationStatus !== 'active'}}" class="btn btn-light" bindtap="authorizeWechat" disabled="{{submitting || loading || error}}">{{authorizationMethod === 'urlScheme' ? '复制微信授权链接' : '授权微信收款'}}</button>
        <button class="btn btn-light" bindtap="load" disabled="{{submitting || loading}}">刷新授权状态</button>
      </view>
      <view class="withdraw-label">可提现余额</view>
      <view class="withdraw-balance">¥{{balance}}</view>
      <view class="withdraw-rules">
        <view>单笔上限：¥{{withdrawRules.maxAmount}}</view>
        <view>手续费：{{withdrawRules.feePercent}}%</view>
        <view>每日次数：{{withdrawRules.dailyCount}}</view>
        <view>每日额度：{{withdrawRules.dailyAmount}}</view>
        <view>今日已申请：{{withdrawRules.todayCount}} 次 / ¥{{withdrawRules.todayAmount}}</view>
        <view>申请时间：全天可提交</view>
        <view wx:if="{{withdrawNoticeLines.length}}" class="withdraw-notice-title">提现说明</view>
        <view wx:for="{{withdrawNoticeLines}}" wx:key="*this" class="muted withdraw-notice-line">{{item}}</view>
      </view>
      <view wx:if="{{noWithdrawableBalance}}" class="muted">暂无可提现余额。</view>
      <view wx:elif="{{withdrawLimitReached}}" class="muted">今日提现次数或额度已用完，请按页面显示的规则再次申请。</view>
      <input class="withdraw-input" type="digit" value="{{amount}}" bindinput="input" placeholder="请输入提现金额" />
      <view wx:if="{{withdrawAmountError}}" class="muted">{{withdrawAmountError}}</view>
      <button class="btn btn-primary withdraw-submit" bindtap="submit" disabled="{{submitting || loading || error || noWithdrawableBalance || withdrawLimitReached || withdrawAmountError || !amount || (authorizationRequired !== false && authorizationStatus !== 'active')}}" loading="{{submitting}}">申请提现</button>
    </view>
    <view wx:for="{{rows}}" wx:key="id" class="card">
      <view>¥{{item.amount}} · {{item.statusText}}</view>
      <view class="muted">申请 {{item.createdAt}}</view>
      <view>手续费 ¥{{item.fee}}，预计到账 ¥{{item.arrivalAmount}}</view>
      <view wx:if="{{item.actualArrivalAmount !== undefined}}">渠道代扣税费 ¥{{item.withheldTaxAmount}}，实际到账 ¥{{item.actualArrivalAmount}}</view>
      <view wx:if="{{item.reason}}">处理说明：{{item.reason}}</view>
      <button wx:if="{{item.status === 'processing' && item.transferState === 'WAIT_USER_CONFIRM'}}" class="btn btn-primary" data-id="{{item.id}}" bindtap="confirmTransfer" loading="{{submitting}}" disabled="{{submitting}}">确认收款</button>
    </view>
  </block>

  <block wx:elif="{{type === 'pickupSite'}}">
    <view wx:for="{{rows}}" wx:key="id" class="card">
      <view class="title">{{item.name}}</view>
      <view>{{item.address}}</view>
    </view>
  </block>

  <block wx:else>
    <view wx:for="{{rows}}" wx:key="id" class="card">
      <view>{{item.subject || title}}</view>
      <view class="muted">{{item.status}}</view>
      <view>{{item.content}}</view>
    </view>
    <view class="card">
      <textarea value="{{content}}" bindinput="text" placeholder="请填写具体内容" />
      <button class="btn btn-primary" bindtap="submit" disabled="{{submitting}}" loading="{{submitting}}">提交</button>
    </view>
  </block>

  <view wx:if="{{!loading && !error && !rows.length && type !== 'withdraw'}}" class="card">暂无记录</view>
</view>
