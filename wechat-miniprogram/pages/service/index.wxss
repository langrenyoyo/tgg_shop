.page { padding-bottom: 40rpx; }.card { margin-bottom: 18rpx; }.title { font-weight: 700; font-size: 34rpx; }.muted { color: #829177; margin-top: 8rpx; }input, textarea { box-sizing: border-box; width: 100%; margin-top: 18rpx; padding: 20rpx; border: 1rpx solid #dce8d9; border-radius: 16rpx; background: #fff; }button { margin-top: 16rpx; }.withdraw-panel { padding: 30rpx; }.withdraw-label { font-size: 30rpx; font-weight: 600; }.withdraw-balance { margin-top: 8rpx; color: #008f55; font-size: 46rpx; font-weight: 700; line-height: 1.25; overflow-wrap: anywhere; }.withdraw-hint { font-size: 26rpx; }.withdraw-input { min-height: 96rpx; padding: 22rpx 24rpx; font-size: 34rpx; line-height: 1.4; }.withdraw-submit { width: 100%; min-height: 88rpx; font-size: 30rpx; }
