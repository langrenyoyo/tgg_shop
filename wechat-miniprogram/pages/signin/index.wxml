<view class="page">
  <view class="card">
    <view class="title">每日签到</view>
    <view class="muted" style="margin-top:8rpx;">连续签到奖励与广告组任务</view>
  </view>

  <view class="card" wx:if="{{status}}">
    <view>连续签到 {{status.streakDays || 0}} 天</view>
    <view class="muted" style="margin-top:8rpx;">{{status.streakRewardText}}</view>
    <view class="muted" style="margin-top:8rpx;">今日广告组 {{status.adGroups || 0}} 组</view>
  </view>

  <view class="card">
    <button class="btn btn-primary" loading="{{loading}}" bindtap="startSignin">开始签到</button>
    <button class="btn btn-light" style="margin-top:16rpx;" bindtap="spinLottery">抽奖</button>
  </view>
</view>
