<view class="page">
  <view wx:if="{{loading}}">正在加载任务</view>
  <view class="card" wx:if="{{error}}">{{error}}<button bindtap="load">重新加载任务</button></view>
  <view class="card" wx:if="{{task}}">
    <view class="title">{{task.title}}</view>
    <view class="muted" style="margin-top:8rpx;">{{task.category || task.type_name || ''}}</view>
    <view wx:if="{{task.rewardValid !== false}}" style="margin-top:16rpx;" class="tag">奖励 {{task.rewardPoints || 0}} 积分</view>
    <view wx:else>任务奖励待核对，暂不可提交，请稍后刷新。<button bindtap="load">刷新任务</button></view>
    <view wx:if="{{task.isTopText || task.platformStatusText}}" class="muted">{{task.isTopText}} {{task.platformStatusText}}</view>
    <view class="muted" style="margin-top:10rpx;">{{task.tishi || '暂无提示'}}</view>
  </view>

  <view class="card" wx:if="{{task && financialRows.length}}">
    <view class="title" style="font-size:30rpx;">平台收益明细</view>
    <view class="muted">以下为平台原值，单位以平台说明为准；本站到账以审核后的积分明细为准。</view>
    <view wx:for="{{financialRows}}" wx:key="key" class="list-item">{{item.label}}：{{item.value}}</view>
  </view>

  <view class="card" wx:if="{{task && task.content}}">
    <view class="title" style="font-size:30rpx;">任务说明</view>
    <view wx:for="{{task.content}}" wx:key="index" class="list-item">
      <rich-text nodes="{{item.txt}}"></rich-text>
      <image wx:for="{{item.img_list}}" wx:for-item="imageUrl" wx:key="*this" src="{{imageUrl}}" mode="widthFix" style="width:100%" />
    </view>
  </view>

  <view class="card">
    <button class="btn btn-primary" bindtap="goSubmit" loading="{{busy}}" disabled="{{busy || loading || !task || task.paused || task.rewardValid === false}}">{{task.paused ? '任务已暂停' : '接单并提交'}}</button>
  </view>
</view>
