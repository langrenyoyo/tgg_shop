[Unit]
Description=TGG Shop PostgreSQL backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/tgg-shop/tgg-shop.env
Environment=TGG_ENV_FILE=/etc/tgg-shop/tgg-shop.env
ExecStart=/www/wwwroot/tgg_shop/dev/backend/deploy/tgg-shop-backup.sh
