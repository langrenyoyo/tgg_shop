# Template only. Generate .env.production with npm run config:init.
# Never commit real credentials. Blank fields need externally supplied values.
NODE_ENV=production
PORT=5177
TGG_STORE_DRIVER=pg
TGG_PG_URL=
TGG_PG_SCHEMA=public
TGG_PG_STATE_ID=main
TGG_AUTH_SECRET=
TGG_AUTH_TOKEN_TTL_SECONDS=28800
TGG_TASK_CALLBACK_TOKEN=
TGG_TASK_PLATFORM_BASE_URL=
TGG_TASK_PLATFORM_APPID=
TGG_TASK_PLATFORM_KEY=
# Confirm the provider's signing calendar time zone before production use.
TGG_TASK_PLATFORM_TIME_ZONE=Asia/Shanghai
TGG_TASK_PLATFORM_TIMEOUT_MS=10000
WECHAT_APPID=
WECHAT_APPSECRET=
# Production host from the supplied payment documentation; HTTPS verified.
LFWIN_BASE_URL=https://api2.lfwin.com
LFWIN_API_KEY=
LFWIN_SIGN_TYPE=RSA
LFWIN_SIGN_KEY=
# RSA: merchant private key and provider verification public key.
# Use literal \n between PEM lines. MD5 uses LFWIN_SIGN_KEY instead.
LFWIN_RSA_PRIVATE_KEY=
LFWIN_RSA_PUBLIC_KEY=
LFWIN_TIMEOUT_MS=10000
LFWIN_NOTIFY_URL=https://shop.taoguoguo.cc/api/payment-providers/lfwin/notify
LFWIN_REFUND_NOTIFY_URL=https://shop.taoguoguo.cc/api/payment/lfwin/refund-notify
# Set to 0 on additional replicas; one instance should run task reconciliation.
TGG_TASK_SWEEP_ENABLED=1
# Optional withdrawal integration; when enabled all four fields are required.
HF_BASE_URL=
HF_COM_KEY=
HF_COM_SECRET=
HF_CALLBACK_TOKEN=
HF_MERCHANT_ID=
HF_WECHAT_APPID=
HF_CALLBACK_URL=https://shop.taoguoguo.cc/api/providers/huifu/withdraw-callback
HF_TRANSFER_MODE=CONFIRM
HF_USER_RECV_PERCEPTION=现金奖励
HF_USER_RECV_TYPE=CONFIRM_PAGE
HF_AUTHORIZATION_NOTIFY_URL=
